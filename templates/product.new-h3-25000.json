        "tab_content_683zbz": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "How should I charge my power bank?",
            "collapsible-content": "<p>You can charge the power bank using either the USB-C retractable cable or the USB-C port.</p>",
            "isactive": false
          }
        },
        "tab_content_fjWWzA": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "Does it support pass-through charging?",
            "collapsible-content": "<p>Yes, to use this feature effectively, please use a charger rated at 65W or higher. Note that the input power must be greater than the total output power in order to charge both the power bank and your devices at the same time.</p>",
            "isactive": false
          }
        },
        "tab_content_Wrb3qd": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "How long does it take to recharge the power bank?",
            "collapsible-content": "<p>The recharge time depends on the charger's power and the ambient temperature. Using a 100W or higher charger at 77°F (25°C), it typically takes about 1.5 hours to fully recharge the power bank.</p>",
            "isactive": false
          }
        },
        "tab_content_KQRxtY": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "Why can't I charge my device up to 65W?",
            "collapsible-content": "<p>The maximum supported charging power varies by device. Charging speed also depends on the device's current battery level—when the battery is already high, it may not reach the maximum charging power.</p>",
            "isactive": false
          }
        },
        "tab_content_NVT3iN": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "Why does the power bank deliver fewer charges than its rated capacity suggests?",
            "collapsible-content": "<p>Energy loss during charging due to inefficiencies in battery cells and circuitry results in a 30% to 45%.</p>",
            "isactive": false
          }
        }
      },
