    "faq_t4cwnM": {
      "type": "faq",
      "blocks": {
        "rich_text_P7gYKR": {
          "type": "rich-text",
          "settings": {
            "heading": "1. Ordering & Pricing",
            "text": "",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_PUtfqG": {
          "type": "question",
          "settings": {
            "title": "<strong>How can I get a corporate discount for RORRY products?</strong>",
            "text": "<p>Our corporate pricing is tiered based on the order quantity. To get a personalized quote, please contact our sales team at <a href=\"mailto:support@rorry.com\" title=\"mailto:support@rorry.com\">support@rorry.com</a>. Share your order quantity, delivery address, and preferred delivery date. We typically respond with a full price list within 12-24 hours.<br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_CPQmmw": {
          "type": "question",
          "settings": {
            "title": "<strong>What is the Minimum Order Quantity (MOQ) for bulk purchases?</strong>",
            "text": "<p>The minimum order quantity (MOQ) for bulk purchases is <strong>40 units</strong>. If you require a different quantity, please contact us first, and we will be happy to discuss your needs.<br/><br/></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_DCqK3q": {
          "type": "question",
          "settings": {
            "title": "<strong>Can I get a formal quote for my company's internal approval?</strong>",
            "text": "<p>Absolutely. Once you select the models and quantities, we will issue a formal PDF quotation including shipping costs and estimated lead times for your procurement department's review.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "rich_text_W8HXbF": {
          "type": "rich-text",
          "settings": {
            "heading": "2. Customization & Branding",
            "text": "",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_RWBYCw": {
          "type": "question",
          "settings": {
            "title": "<strong>Where can my company logo be placed on the charger?</strong>",
            "text": "<p>We offer high-precision laser engraving or silk-screen printing. The logo is typically placed on the front or side of the power banks to ensure maximum visibility without compromising the product's aesthetic.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_4PcamU": {
          "type": "question",
          "settings": {
            "title": "<strong>How long does the customization process take?</strong>",
            "text": "<p>After you approve the digital mockup (usually provided within 24 hours), bulk production takes <strong>3-7 business days</strong>. Total turnaround time, including global express shipping, is approximately <strong>10-15 days</strong>.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_AeJre9": {
          "type": "question",
          "settings": {
            "title": "<strong>How many colors can be used for a custom logo?</strong>",
            "text": "<p>We support both laser engraving and full-color logo printing. The available customization method will depend on your logo design and printing requirements.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_AQXRwy": {
          "type": "question",
          "settings": {
            "title": "<strong>Where should I send my logo file for customization?</strong>",
            "text": "<p>Please email your logo file to support@rorry.com. For the best printing results, we recommend providing a vector file in formats such as SVG, AI, EPS, PDF, or CDR.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "rich_text_xWNRLG": {
          "type": "rich-text",
          "settings": {
            "heading": "3. Finance & Invoicing",
            "text": "",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_U3TgRD": {
          "type": "question",
          "settings": {
            "title": "<strong>How do I apply for an invoice for my bulk order?</strong>",
            "text": "<p>You can request an invoice during checkout or by contacting our support team after payment. Once your order is shipped, a formal commercial invoice will be sent to your registered email address.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "rich_text_kDzjCa": {
          "type": "rich-text",
          "settings": {
