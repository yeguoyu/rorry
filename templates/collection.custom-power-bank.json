            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_JNkTMN": {
          "type": "question",
          "settings": {
            "title": "<strong>Do you offer priority shipping for large corporate orders?</strong>",
            "text": "<p>Yes, all wholesale orders are shipped via <strong>Global Air Express (DHL/UPS/FedEx)</strong>. We provide door-to-door tracking to ensure your gifts arrive safely and on time for your event.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_tKa79y": {
          "type": "question",
          "settings": {
            "title": "<strong>Are wholesale products covered under the RORRY warranty?</strong>",
            "text": "<p>Yes, all RORRY products purchased through our corporate program are covered by our <strong>12-Month Protection Plan</strong>. We provide hassle-free replacements for any units with manufacturing defects.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
