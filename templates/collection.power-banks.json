    "rich_text_cy3zD6": {
      "type": "rich-text",
      "blocks": {
        "heading_haMdaU": {
          "type": "heading",
          "settings": {
            "heading": "Choosing the Best Portable Power: A Guide to RORRY’s Aesthetic Tech",
            "heading_size": "title-sm",
            "heading_tag": "h2",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text_KGJVDn": {
          "type": "text",
          "settings": {
            "text": "<ol><li><strong>Ditch the Cable Clutter</strong><br/>Most <strong>portable chargers</strong> solve one problem but create another: a \"spaghetti mess\" of wires in your designer bag. At RORRY, we redefine the <strong>battery pack</strong> as a fashion accessory. Our <strong>3-in-1 power banks</strong> feature<strong> built-in cables</strong> for both iPhone and USB-C devices, plus an integrated Apple Watch wireless charger. It’s not just a tool; it’s a lifestyle upgrade that ensures your bag remains as organized as your day.</li><li><strong>Power That Matches Your Aesthetic</strong><br/>Why settle for a bulky black brick? Our slim fast charging solutions are available in a curated palette of Rose Quartz, Lavender, and Cream. Whether you need a handheld charger for iPhone that slips into a clutch or a magsafe power bank that snaps seamlessly to your phone, RORRY products are designed to complement your tech ensemble, not distract from it.</li><li><strong>Find Your RORRY Match</strong></li></ol><ul><li><strong>For the Daily Commuter:</strong> The <a href=\"/collections/d2-series-portable-chargers\" title=\"D2 Series Portable Chargers\"><strong>D2 Keychain Series</strong></a> is our best portable charger for those who value extreme portability. It’s lipstick-sized and always ready for an emergency \"juice-up\" for your Watch and iPhone.</li><li><strong>For the Jetsetter:</strong> If you’re looking for a portable power station that is airline-approved, our <a href=\"/products/rorry-d5-10000mah-portable-charger-usb-c-power-bank\" title=\"RORRY PalmGo D5-10000mAh Portable Charger USB-C Power Bank\"><strong>10000mAh PalmGo D5</strong></a> or <a href=\"/products/rorry-charmgo-d4-10000mah-portable-charger-keychainpower-bank-45w\" title=\"RORRY CharmGo D4-10000mAh Portable Charger Keychain Power Bank 45W\"><strong>D4 series</strong></a> provides multiple full charges, making them essential travel accessories for long-haul flights.</li><li><strong>For the Tech-Savvy Professional:</strong> Our MagSafe duo chargers offer the ultimate convenience of magnetic attachment, perfect for a <strong>clutter-free desk setup</strong> or hands-free navigation.</li></ul>",
            "text_font": "body",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
