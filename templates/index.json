    "zl_wall_reviews_Uc8Az4": {
      "type": "zl-wall-reviews",
      "blocks": {
        "review_Wy7KhW": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/a1.jpg",
            "review_title": "My favorite charger!",
            "stars": 5,
            "text": "Compact! Fits in purse easily. I like that it is compatible with both charger types so I can use on my phone and iPad. I use it when traveling for my Apple watch. Durable and great quality! Great value for the money!",
            "author": "Angie"
          }
        },
        "review_VDGxT6": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/ba5aab27035d8dacf33731fbfa5489c9.png",
            "review_title": "This made my life so easy!",
            "stars": 5,
            "text": "This is a power bank that every working person should have! I really like the design, the color, and the way it can charge all of my devices together, and it's really cool! I can charge my AirPods, watch, and phone all together and can still have much power left in it! It's not just stylish but also useful in many ways. It works the best while traveling and takes up less space too!",
            "author": "Lasya Konduru"
          }
        },
        "review_zMiABD": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/a2.jpg",
            "review_title": "Perfect for travel",
            "stars": 5,
            "text": "Amazing love it I used it to my trip to London and it was compact and no need to have wires it was all in one … great product",
            "author": "maridaly"
          }
        },
        "review_Vwx4h7": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/image_32_517f150e-1a1a-4615-91ca-103d2985f857.jpg",
            "review_title": "It can be plugged in even with a protective case on!",
            "stars": 5,
            "text": "It's been a long time since I bought something I was so satisfied with! I heard some people say it wouldn't fit with an iPhone case on, but I tried it and it worked perfectly! It's lightweight and the design is great! I especially love the cute battery level display feature. ♡",
            "author": "Wilson"
          }
        },
        "review_jGji9i": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/a3.jpg",
            "review_title": "Compact, light weight, and charges quickly!",
            "stars": 5,
            "text": "Charges quickly and recharges my phone even more rapidly! It holds a charge for a reasonable amount of time. It is a good size but not heavy. It fits in a small bag without taking up too much space. It has two different types of adapters, which should fit most phone sizes.",
            "author": "Emma"
          }
        },
        "review_M9DApe": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/image_7_77c818ee-b220-4a54-ae84-97df4ca22ac1.jpg",
            "review_title": "This is all in one!",
            "stars": 5,
            "text": "It is compact and light at 10000 mA. The shape and shape are particularly nice when using while charging.\nSince it is compatible with pass-through charging, it was helpful to be able to charge my iPhone and Apple Watch with just this when I was on a business trip",
            "author": "Centriculous"
          }
        },
        "review_FHFM8r": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/a4.png",
            "review_title": "Durable, discreet design, well built",
            "stars": 5,
            "text": "I like their product line. I have total of 4 of them now and they work very well. With this bigger capacity, I can charge all my apple devices at the same time. This is perfect go-to powerbank for travel. Powder blue is fire!",
            "author": "KGI"
          }
        },
        "review_f43MnJ": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/a5.png",
            "review_title": "Portable Charger for All Apple Devices",
            "stars": 5,
            "text": "I am excited to have a portable charger that will charge me phone, my headphones AND my watch! As soon as I saw that it would charge my watch, I had to have it. I wouldn’t wear my watch to bed always because of the battery dying during the day. Now I can and I do! My portable charger works great!",
            "author": "Violet"
          }
        },
        "review_cfUKNY": {
