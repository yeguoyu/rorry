    "product_faq_iXcLnC": {
      "type": "product-faq",
      "blocks": {
        "tab_Fq7LBp": {
          "type": "tab",
          "settings": {
            "tab-name": "Product"
          }
        },
        "tab_content_683zbz": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>Can I charge my iPhone, Apple Watch, and AirPods at the same time?</strong>",
            "collapsible-content": "<p>Yes. This 4-in-1 charging station is designed to charge your iPhone, Apple Watch, and AirPods simultaneously, making it a convenient all-in-one solution for your Apple devices.</p>",
            "isactive": false
          }
        },
        "tab_content_fjWWzA": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>Does the power bank charge while the phone is attached?</strong>",
            "collapsible-content": "<p>No. When your phone is connected to the charging stand, the power bank will not charge. To recharge the power bank, you need to first remove your phone from the stand.</p>",
            "isactive": false
          }
        },
        "tab_content_Wrb3qd": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>How long does it take to fully charge the devices?</strong>",
            "collapsible-content": "<p>Using the 30W USB-C adapter, it takes about 2 hours to fully charge the power bank, and around 3 hours to charge an iPhone, Apple Watch, and AirPods simultaneously (depending on device models and usage conditions).<br/></p>",
            "isactive": false
          }
        },
        "tab_content_KQRxtY": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>Is the magnetic power bank removable?</strong>",
            "collapsible-content": "<p>Yes. The 10,000mAh magnetic power bank is detachable and can be used separately. It also supports magnetic charging and can function as a phone stand for watching videos or attending meetings.</p>",
            "isactive": false
          }
        },
        "tab_content_NVT3iN": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>Which devices are compatible with this charging station?</strong>",
            "collapsible-content": "<p>It is compatible with iPhone 12–17 series, Apple Watch Ultra/Series 4–11, and AirPods 2–Pro 3. It is designed specifically for Apple ecosystem devices with MagSafe or magnetic cases.</p>",
            "isactive": false
          }
        },
        "tab_content_rjgjrP": {
          "type": "tab-content",
          "settings": {
            "tab-name": "Product",
            "collapsible-title": "<strong>Does it support fast charging?</strong>",
            "collapsible-content": "<p>Yes. The 30W USB-C port supports fast charging, allowing compatible iPhones (such as iPhone 17 Pro) to reach up to 50% charge in about 30 minutes under optimal conditions.</p>",
            "isactive": false
          }
        },
        "tab_content_pyUjBg": {
          "type": "tab-content",
          "disabled": true,
          "settings": {
            "tab-name": "product",
            "collapsible-title": "<strong>Does this charging bundle come with a charging adapter and cable?</strong>",
            "collapsible-content": "<p>All essential accessories are included in the package: the 4-in-1 magnetic charging dock with detachable 10000mAh power bank, a 30W USB-C power adapter, a 40-inch USB-C to USB-C cable, a magnetic reinforcement ring and a user guide. </p>",
            "isactive": false
          }
        }
      },
