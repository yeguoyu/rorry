    "faq_XjyrqX": {
      "type": "faq",
      "blocks": {
        "question_tHQEij": {
          "type": "question",
          "settings": {
            "title": "1. Do I need a large following to apply?",
            "text": "<p>No. Audience size is only one consideration. We also review content quality, originality, audience fit, engagement, reliability, and how naturally RORRY products fit your everyday content.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_UJRxzq": {
          "type": "question",
          "settings": {
            "title": "2. Will I receive a free product?",
            "text": "<p>Not every applicant receives a product. Product seeding depends on selection, campaign fit, location, inventory, and the agreed deliverables. We will explain the offer before you accept a collaboration.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_w8dAMF": {
          "type": "question",
          "settings": {
            "title": "3. Which platforms are eligible?",
            "text": "<p>We welcome public content on TikTok, Instagram, YouTube, Pinterest, blogs, and other relevant platforms. The platforms included in each opportunity may vary.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_Gqnktg": {
          "type": "question",
          "settings": {
            "title": "4. Can I earn commission?",
            "text": "<p>Some campaigns include affiliate opportunities for eligible creators. Commission rates, qualifying purchases, attribution periods, payment thresholds, and exclusions are provided in the applicable affiliate terms.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_zxNBBt": {
          "type": "question",
          "settings": {
            "title": "5. What kind of content does RORRY need?",
            "text": "<p>Common formats include unboxings, product demonstrations, desk setups, everyday carry, what’s-in-my-bag videos, travel routines, charging tips, comparisons, and short-form lifestyle content.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_DhYJif": {
          "type": "question",
          "settings": {
            "title": "6. Who owns the content I create?",
            "text": "<p>Ownership and usage rights depend on the collaboration agreement. RORRY will provide the proposed channels, duration, editing rights, paid-media rights, and credit terms before content is reused.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_zARPtV": {
          "type": "question",
          "settings": {
            "title": "7. How will I know if I am selected?",
            "text": "<p>If your profile matches an available opportunity, the RORRY team will contact you using the email address submitted with your application. Response timing may vary with campaign volume.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_JN897q": {
          "type": "question",
          "settings": {
            "title": "8.Can creators outside the United States apply?",
            "text": "<p>You may apply from another country, but product availability, shipping, affiliate access, and campaign eligibility vary by market.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_wHLVDU": {
          "type": "question",
          "settings": {
            "title": "9. How can I update or remove my application data?",
            "text": "<p>Contact support@rorry.com and include the email address used in your application. Requests are handled under the RORRY Privacy Policy and applicable law.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
