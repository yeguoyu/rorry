
{%- assign blog_handles_string = "editors-picks,tech-explained,lifestyle-setup" -%}
{%- assign blog_list = blog_handles_string | split: ',' -%}

<div class="zl-blog-nav">
  <div class="zl-container">
    <ul class="zl-category-list">
      
  
      {%- for handle in blog_list -%}
        {%- assign target_blog = blogs[handle] -%}
        
    
        {%- if target_blog != blank -%}
          <li class="zl-category-item">
            <a href="{{ target_blog.url }}" 
               class="{% if blog.handle == handle %}zl-active{% endif %}">
              {{ target_blog.title }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      
    </ul>
  </div>
</div>

<style>
 
.zl-blog-nav {
  border-bottom: 1px solid #e8e8e8;
  background: #fff;
  width: 100%;
  padding: 15px 20px;
  margin-bottom: 30px;
  position: relative;
  max-width: 1400px; 
  margin: 0 auto;
   margin-bottom:30px;
}



.zl-category-list {
  display: flex;
  justify-content: flex-end; 
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 30px; 
}


.zl-category-item a {
  text-decoration: none;
  color: #333;
  font-size: 15px;
  font-weight: 500;
  transition: color 0.2s;
  padding-bottom: 5px;
  display: block;
}


.zl-category-item a.zl-active {
  color: #9887B8;
  border-bottom: 2px solid #9887B8;
}

.zl-category-item a:hover {
  color: #9887B8;
}


@media (max-width: 768px) {
  .zl-category-list {
    justify-content: flex-start;
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 10px;
  }
}
</style>