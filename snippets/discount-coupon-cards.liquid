{%- comment -%}
  Discount Coupon Cards (row layout)
  Usage: {% render 'discount-coupon-cards', block: block, section: section %}
{%- endcomment -%}

{%- liquid
  assign copy_text = block.settings.copy_text | default: 'Copy Code'
  assign card_count = 0

  if block.settings.card_1_discount_code != blank or block.settings.card_1_code_label != blank
    assign card_count = card_count | plus: 1
  endif
  if block.settings.card_2_discount_code != blank or block.settings.card_2_code_label != blank
    assign card_count = card_count | plus: 1
  endif
  if block.settings.card_3_discount_code != blank or block.settings.card_3_code_label != blank
    assign card_count = card_count | plus: 1
  endif

  if block.settings.tag_icon != blank
    assign tag_icon_url = block.settings.tag_icon | image_url: width: 64
    assign tag_icon_width = block.settings.tag_icon.width | at_most: 64
  else
    assign tag_icon_url = 'coupon-tag-icon.png' | asset_url
    assign tag_icon_width = 64
  endif
-%}

{%- if card_count > 0 -%}
  <div class="product__coupon-cards" id="CouponCards-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="tf-coupon-cards-row" data-card-count="{{ card_count }}">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign badge = block.settings.card_1_badge
              assign amount = block.settings.card_1_amount
              assign code_label = block.settings.card_1_code_label
              assign discount_code = block.settings.card_1_discount_code
            when 2
              assign badge = block.settings.card_2_badge
              assign amount = block.settings.card_2_amount
              assign code_label = block.settings.card_2_code_label
              assign discount_code = block.settings.card_2_discount_code
            when 3
              assign badge = block.settings.card_3_badge
              assign amount = block.settings.card_3_amount
              assign code_label = block.settings.card_3_code_label
              assign discount_code = block.settings.card_3_discount_code
          endcase

          if discount_code == blank
            assign discount_code = code_label
          endif
        -%}

        {%- if discount_code != blank or code_label != blank -%}
          <div class="tf-coupon-card">
            <div class="tf-coupon-card__shell">
              <div class="tf-coupon-card__top">
                <div class="tf-coupon-card__header">
                  <img
                    class="tf-coupon-card__tag-icon"
                    src="{{ tag_icon_url }}"
                    alt=""
                    width="22"
                    height="22"
                    loading="lazy"
                  >
                  {%- if badge != blank -%}
                    <span class="tf-coupon-card__badge">{{ badge }}</span>
                  {%- endif -%}
                </div>
                {%- if amount != blank -%}
                  <div class="tf-coupon-card__amount">{{ amount }}</div>
                {%- endif -%}
                {%- if code_label != blank -%}
                  <div class="tf-coupon-card__code-label">With Code: {{ code_label }}</div>
                {%- endif -%}
              </div>

              <div class="tf-coupon-card__divider" aria-hidden="true">
                <span class="tf-coupon-card__notch tf-coupon-card__notch--left"></span>
                <span class="tf-coupon-card__notch tf-coupon-card__notch--right"></span>
              </div>

              <div class="tf-coupon-card__bottom">
                <button
                  type="button"
                  class="tf-coupon-card__copy-btn"
                  data-copy-code="{{ discount_code | escape }}"
                  data-copy-label="{{ copy_text | escape }}"
                >
                  {{ copy_text }}
                </button>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <style>
    #CouponCards-{{ section.id }}-{{ block.id }} {
      width: 80%;
      margin-top: 10px;
      margin-bottom: 0;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-cards-row {
      display: flex;
      flex-wrap: nowrap;
      gap: 10px;
      width: 100%;
      margin-bottom: 10px;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card {
      flex: 1 1 0;
      min-width: 0;
      overflow: visible;
      text-align: center;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__shell {
      display: flex;
      flex-direction: column;
      height: 100%;
      border-radius: 4px;
      overflow: visible;
      -webkit-mask-image:
        radial-gradient(circle at 0 0, transparent 5px, #000 5.5px),
        radial-gradient(circle at 100% 0, transparent 5px, #000 5.5px),
        radial-gradient(circle at 0 100%, transparent 5px, #000 5.5px),
        radial-gradient(circle at 100% 100%, transparent 5px, #000 5.5px);
      -webkit-mask-size: 51% 51%;
      -webkit-mask-position: top left, top right, bottom left, bottom right;
      -webkit-mask-repeat: no-repeat;
      mask-image:
        radial-gradient(circle at 0 0, transparent 5px, #000 5.5px),
        radial-gradient(circle at 100% 0, transparent 5px, #000 5.5px),
        radial-gradient(circle at 0 100%, transparent 5px, #000 5.5px),
        radial-gradient(circle at 100% 100%, transparent 5px, #000 5.5px);
      mask-size: 51% 51%;
      mask-position: top left, top right, bottom left, bottom right;
      mask-repeat: no-repeat;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__top {
      background: #e8e4f2;
      padding: 14px 8px 12px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 106px;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-bottom: 10px;
      width: 100%;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__tag-icon {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      object-fit: contain;
      display: block;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__badge {
      display: inline-block;
      background: #1a1a1a;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.01em;
      padding: 4px 10px;
      border-radius: 999px;
      line-height: 1.2;
      white-space: nowrap;
      text-align: center;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__amount {
      font-size: 22px;
      font-weight: 800;
      color: #1a1a1a;
      line-height: 1;
      margin: 0 0 8px;
      letter-spacing: -0.02em;
      text-align: center;
      width: 100%;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__code-label {
      font-size: 12px;
      font-weight: 500;
      color: #333;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      text-align: center;
      width: 100%;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__divider {
      position: relative;
      height: 12px;
      background: #9887b8;
      border-top: 2px dashed #fff;
      flex-shrink: 0;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch {
      position: absolute;
      top: 50%;
      width: 12px;
      height: 12px;
      margin-top: -6px;
      background: #fff;
      border-radius: 50%;
      z-index: 2;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch--left {
      left: -6px;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch--right {
      right: -6px;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__bottom {
      background: #9887b8;
      padding: 0 8px 12px;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__copy-btn {
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      line-height: 1.2;
      transition: opacity 0.2s;
      text-align: center;
      width: 100%;
    }

    #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__copy-btn:hover {
      opacity: 0.85;
    }

    @media (max-width: 1400px) {
      #CouponCards-{{ section.id }}-{{ block.id }} {
        width: 100%;
      }
    }

    @media (max-width: 768px) {
      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-cards-row {
        gap: 6px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__top {
        padding: 10px 4px 8px;
        min-height: 88px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__header {
        gap: 4px;
        margin-bottom: 6px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__tag-icon {
        width: 16px;
        height: 16px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__badge {
        font-size: 7px;
        padding: 3px 6px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__amount {
        font-size: 22px;
        margin-bottom: 4px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__code-label {
        font-size: 9px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__divider {
        height: 10px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch {
        width: 10px;
        height: 10px;
        margin-top: -5px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch--left {
        left: -5px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__notch--right {
        right: -5px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__bottom {
        padding: 0 4px 8px;
      }

      #CouponCards-{{ section.id }}-{{ block.id }} .tf-coupon-card__copy-btn {
        font-size: 11px;
      }
    }
  </style>

  <script data-no-lazy="1">
    (function () {
      var root = document.getElementById('CouponCards-{{ section.id }}-{{ block.id }}');
      if (!root) return;

      function copyCode(btn, code) {
        if (!code) return;
        navigator.clipboard.writeText(code).then(function () {
          var originalText = btn.getAttribute('data-copy-label') || btn.innerText;
          btn.innerText = 'Copied!';
          setTimeout(function () {
            btn.innerText = originalText;
          }, 2000);
        });
      }

      window.tfCopyCode =
        window.tfCopyCode ||
        function (btn, code) {
          copyCode(btn, code);
        };

      root.querySelectorAll('.tf-coupon-card__copy-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          copyCode(btn, btn.getAttribute('data-copy-code'));
        });
      });
    })();
  </script>
{%- endif -%}
