{% comment %}
  Snippet: Sidebar Related Articles (Smart Scroll)
  Usage: {% render 'article-related-posts', article: article %}
  Description: Displays selected articles. Hides scroll buttons if items are <= 4.
{% endcomment %}

{% assign related_articles = article.metafields.custom.related_articles.value %}

{% if related_articles != blank %}
  <div class="sidebar-widget-wrapper">
    <h3 class="widget-title">Related Articles</h3>

    <div class="product-scroll-window" {% if related_articles.size <= 4 %}style="height:auto;"{% endif %}>
      <div class="product-list">
        {% for rel_article in related_articles %}
          <div class="sidebar-product-card">
            <a href="{{ rel_article.url }}" class="product-link">
              
              <div class="product-image">
                {% if rel_article.image %}
                  <img src="{{ rel_article.image | image_url: width: 200, height: 200, crop: 'center' }}" 
                       alt="{{ rel_article.title | escape }}" 
                       loading="lazy" 
                       width="70" 
                       height="70">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>

              <div class="product-info">
                <h4 class="product-title">{{ rel_article.title | truncate: 45 }}</h4>
                <div class="article-meta">
                  <span class="meta-date" style="font-size:13px">
                    <svg class="meta-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    {{ rel_article.published_at | date: "%Y-%m-%d" }}
                  </span>
      
                </div>
              </div>

              <div class="cart-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    {% if related_articles.size > 4 %}
      <div class="sidebar-controls">
        <button class="control-btn up-btn" type="button" aria-label="Scroll Up">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
        </button>
        <button class="control-btn down-btn" type="button" aria-label="Scroll Down">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
    {% endif %}
  </div>




{% endif %}