{% comment %}
  Snippet: Article Sidebar Recommended Products (Bottom Controls UI)
  Usage: {% render 'article-recommended-products', article: article %}
  Description: Displays a list of products via Metafields with split navigation buttons at the bottom.
{% endcomment %}

{% assign recommended_products = article.metafields.custom.recommended_products.value %}

{% if recommended_products != blank %}
  <div class="sidebar-widget-wrapper">
    <div class="widget-title">Recommended for you</div>

    <div class="product-scroll-window">
      <div class="product-list">
        {% for product in recommended_products %}
          <div class="sidebar-product-card">
            <a href="{{ product.url }}" class="product-link">
              <div class="product-image">
                <img src="{{ product.featured_image | image_url: width: 200 }}" 
                     alt="{{ product.title | escape }}" 
                     loading="lazy" 
                     width="80" 
                     height="80">
              </div>
              <div class="product-info">
                <h4 class="product-title">{{ product.title | truncate: 40 }}</h4>
                <div class="product-price">
                  <span class="current-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              
              </div>
              <div class="cart-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="sidebar-controls">
      <button class="control-btn up-btn" type="button" aria-label="Scroll Up">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
      </button>
      
      <button class="control-btn down-btn" type="button" aria-label="Scroll Down">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
  </div>


{% endif %}