{% assign faq_questions = collection.metafields.custom.faq_question.value %}
{% assign faq_answers  = collection.metafields.custom.faq_answer.value %}

{% if faq_questions.size > 0 and faq_answers.size > 0 %}
<section class="default-faq">
    <div class="conner">
        <div class="title-header">
            <h2 class="heading  title-md">
                FAQs
            </h2>
        </div>
        <div class="default-faq-container">
            {% for question in faq_questions %}
                <div class="default-faq-item {% if forloop.index > 5 %}faq-hidden{% endif %}">
                    <div class="default-faq-question s16">
                        <h3 class="default-faq-question-h3">{{ question }}</h3>
                        <span class="arrow"><img src="https://cdn.shopify.com/s/files/1/0623/1936/2138/files/icon_arrow_faq.svg?v=1731577302" alt=""></span>
                    </div>
                    <div class="default-faq-answer">
                        {{ faq_answers[forloop.index0] }}
                    </div>
                </div>
            {% endfor %}
            
            {% if faq_questions.size > 5 %}
                <div class="faq-toggle-container">
                    <button class="faq-toggle-button">Read More</button>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}

<style>
.title-header{
  margin-bottom: 2.5rem;
}
.h2-title{
  text-align: center;
  font-size: 2.5rem;
  color: #000b46;
  margin-bottom: 0;
}

.default-faq-container {
  max-width: 1200px; 
  width: 90%; 
  margin: 0 auto;
  padding: 0 15px;
}

.default-faq-item {
  background: #fff;
  border-radius: 8px;
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: all 0.4s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08); 
}

.default-faq-question {
  width: 100%;
  border-top: 1px solid #EEEEEE;
  border-bottom: 1px solid #EEEEEE;
  padding: 1.5rem 1.7rem;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 500;
}

.default-faq-answer {
  font-size: 1.2rem;
  line-height: 1.6;
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s ease;
  align-items: center;
  font-weight: 300; 
}

.default-faq-answer.active {
  height: auto;
  opacity: 1;
  padding: 1.5rem;
  min-height: 60px;
  word-wrap: break-word;
}

.default-faq-question .arrow {
  transition: transform 0.4s ease;
  width: 25px;
}

.default-faq-question.active .arrow {
  transform: rotate(180deg);
}

.default-faq-question-h3 {
  font-size: 1.3rem;
  font-weight: 400;
  line-height: 1.4;
  text-align: left;
  color: #000b46;
  width: 90%;
  margin: 0;
  font-weight: 400; 
}

.default-faq-answer b {
  font-weight: 700;
}

.faq-hidden {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  margin-bottom: 0;
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), 
              opacity 0.5s ease, 
              margin-bottom 0.5s ease;
  transform: translateZ(0);
  display: none;
}

.faq-visible {
  max-height: 1000px; 
  opacity: 1;
  margin-bottom: 1.5rem;
}

.faq-toggle-container {
  text-align: center;
  margin: 30px 0 50px;
  transition: margin 0.3s ease;
}

.faq-toggle-button {
  background-color: #000b46;
  color: white;
  border: none;
  padding: 1.2rem 1.5rem;
  border-radius: 10px;
  cursor: pointer;
  font-size: 1rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  outline: none;
  position: relative;
  overflow: hidden;
}

.faq-toggle-button:hover {
  background-color: #153b58;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 33, 75, 0.15);
}

.faq-toggle-button:active {
  transform: translateY(0);
}

.faq-toggle-button::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 5px;
  height: 5px;
  background: rgba(255, 255, 255, 0.5);
  opacity: 0;
  border-radius: 100%;
  transform: scale(1, 1) translate(-50%, -50%);
  transform-origin: 50% 50%;
}

.faq-toggle-button:focus:not(:active)::after {
  animation: ripple 0.6s ease-out;
}

@keyframes ripple {
  0% {
    transform: scale(0, 0);
    opacity: 0.5;
  }
  100% {
    transform: scale(20, 20);
    opacity: 0;
  }
}

@media only screen and (max-width: 768px) {
  
  .h2-title {
    font-size: 1.5rem;
  }
  
  .default-faq-container {
    width: 95%;
    padding: 0 10px;
  }
  
  .default-faq-item {
    margin-bottom: 1.2rem;
  }
  
  .default-faq-question {
    padding: 1.2rem;
  }
  
  .default-faq-question-h3 {
    font-size: 1.2rem;
  }
  
  .default-faq-answer {
    font-size: 1rem;
  }
  
  .default-faq-answer.active {
    padding: 1.2rem;
    min-height: 50px;
  }
}

.default-faq-answer a {
  color: #000b46; 
  text-decoration: underline; 
  font-weight: 600; 
  display: inline;
}
  .faq-hidden {
    display: none;
  }
</style>


<script>
document.addEventListener("DOMContentLoaded", function() {
    const faqItems = document.querySelectorAll(".default-faq-item");
    const toggleButton = document.querySelector(".faq-toggle-button");
    
    faqItems.forEach(item => {
        const question = item.querySelector(".default-faq-question");
        const answer = item.querySelector(".default-faq-answer");

        question.addEventListener("click", () => {
            const isActive = answer.classList.contains("active");

            // Reset all
            faqItems.forEach(i => {
                i.querySelector(".default-faq-answer").classList.remove("active");
                i.querySelector(".default-faq-question").classList.remove("active");
            });

            // Toggle current item
            if (!isActive) {
                answer.classList.add("active");
                question.classList.add("active");
            }
        });
    });
    
    if (toggleButton) {
        toggleButton.addEventListener("click", function() {
            const isExpanded = this.textContent.trim() === "Read More";
            this.disabled = true;
            
            const itemsToToggle = Array.from(document.querySelectorAll(".default-faq-item")).slice(5);
            
            itemsToToggle.forEach((item, index) => {
                setTimeout(() => {
                    if (isExpanded) {
                        item.style.display = 'block';
                        setTimeout(() => {
                            item.classList.remove("faq-hidden");
                            item.classList.add("faq-visible");
                        }, 10);
                    } else {
                        item.classList.remove("faq-visible");
                        item.classList.add("faq-hidden");
                        setTimeout(() => {
                            item.style.display = 'none';
                        }, 500);
                    }
                }, index * 30);
            });
            
            setTimeout(() => {
                this.disabled = false;
                this.textContent = isExpanded ? "Read Less" : "Read More";
                
                if (isExpanded && itemsToToggle.length > 0) {
                    itemsToToggle[0].scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'nearest' 
                    });
                }
            }, 500);
        });
    }
});
</script>