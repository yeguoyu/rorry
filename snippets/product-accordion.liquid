  <style>
    #shopify-section-{{ section.id }} .accordion {
      border-radius: 4px;
      margin: 0 auto;
      border:none;
          /* margin-bottom: 10px; */
      width:100%;
    }

    #shopify-section-{{ section.id }} .accordion-items {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .accordion-header {
      cursor: pointer;
      background: transparent;
      border: none;
font-size: 16px;
font-weight: 500;
line-height: 24px;
text-align: left;
      outline: none;
      flex-grow: 1;
      padding:0;
      font-family: unset;
    }
    #shopify-section-{{ section.id }} .accordion-header p{
      
    }
    #shopify-section-{{ section.id }} .drow-down {
      display:flex;
      transition: transform 0.3s ease;
          cursor: pointer;
    }

    #shopify-section-{{ section.id }} .accordion-contents {
      overflow: hidden;
      max-height: 0;
      transition: max-height 0.3s ease;
      background:transparent;
      padding: 0 0;
      letter-spacing:0;      
          border-bottom: 1px solid rgba(0, 0, 0, .1);
    }

   /* .accordion-contents p:first-of-type {
    padding-top:20px;
} */
    #shopify-section-{{ section.id }} .accordion-contents *{
      margin-top:0;
          margin-bottom: 10px;
          margin-left: 20px;
      
    }
    #shopify-section-{{ section.id }} .accordion-contents.active {
      padding: 15px 0;
      max-height: 500px; 
    }

    #shopify-section-{{ section.id }} .accordion-items.active .drow-down {
      transform: rotate(180deg); /* 图标旋转 */
    }

    #shopify-section-{{ section.id }} .accordion-list {
      max-width: 80%;
      padding: 20px 0;
      margin: 0;
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(150px, auto));
      grid-template-rows: repeat(3, auto);
      gap: 10px;
      column-gap: 40px;
    }

    #shopify-section-{{ section.id }} .accordion-list-item {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 10px;
      max-width: 300px;
    }

    #shopify-section-{{ section.id }} .accordion-list-item .item-logo {
      width: 40px;
      height: 40px;
    }

    #shopify-section-{{ section.id }} .accordion-list-item span {
      color: #231515;
      font-size: 14px;
      line-height: 21px;
      font-weight: 400;
    }
    #shopify-section-{{ section.id }} .img-mode{
      display:flex;
      gap:20px;
          padding-top: 10px;
    }
    #shopify-section-{{ section.id }} .img-mode img{
      width:80px;
      height:80px;
    }
	@media (max-width:750px){
          #shopify-section-{{section.id}} .accordion-contents *{
     margin-left:0; 
    }
           #shopify-section-{{section.id}} .accordion-contents{
    border-radius: 5px;
             padding:0;
             white-space: normal;
             word-break: break-word;
    background: var(--Color-7, #6B87940A);
    }
      #shopify-section-{{section.id}} .accordion-items.active + .accordion-contents {
          padding: 10px;
        
}
		#shopify-section-{{ section.id }} .accordion-list-item span{
			font-size: 12px;
			line-height: 21px;
		}
       #shopify-section-{{ section.id }} .accordion-list {
         column-gap: 10px;
       }
      #shopify-section-{{ section.id }} .img-mode img{
      width:55px;
      height:55px;
    }
	}

  #shopify-section-{{ section.id }} .accordion-contents strong {
  margin-left: 0 
}

  #shopify-section-{{ section.id }} .accordion-contents a {
      margin-left: 0;
  }

  #shopify-section-{{ section.id }} .accordion-header .accordion-title {
    font-size: 20px;
    line-height: 1.2;
  }

  @media (max-width: 750px) {
    #shopify-section-{{ section.id }} .accordion-header .accordion-title {
      font-size: 16px;
    }
  }
  </style>


<div class="accordion s">
  <div class="accordion-items {% if block.settings.isactive %}active{% endif %}">
    <button class="accordion-header">
      <h3 class="accordion-title">
        {{ block.settings.collapsible-title | replace: '\u0026nbsp;', ' '}}
      </h3>
    </button>
    <div class="drow-down">
      <svg t="1723627521588" class="aicon"  viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4779" width="20" height="20">
        <path d="M183.168 332.501333a42.666667 42.666667 0 0 1 57.621333-2.496l2.709334 2.496L512 600.96l268.501333-268.48a42.666667 42.666667 0 0 1 57.621334-2.496l2.709333 2.496a42.666667 42.666667 0 0 1 2.496 57.621333l-2.496 2.709334-298.666667 298.666666a42.666667 42.666667 0 0 1-57.621333 2.496l-2.709333-2.496-298.666667-298.666666a42.666667 42.666667 0 0 1 0-60.330667z" fill="#000000" p-id="4780"></path>
      </svg>
    </div>
  </div>
  <div class="accordion-contents">
    <!--文本  -->
    {{ block.settings.collapsible-content  | replace: '\u0026nbsp;', ' '}}
  </div>
</div>

