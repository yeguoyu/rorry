{% comment %}
  Section: ZL TikTok Embed Slider
  Fixed:
  1. iframe 拦截滑动问题
  2. Swiper 重复初始化问题
  3. Shopify 未定义报错
{% endcomment %}

{%- liquid
  assign section_id = 'zl-ti-' | append: section.id
-%}

<section id="{{ section_id }}" class="zl-ti-section">
  <div class="zl-ti-container">
    <div class="zl-ti-upper-wrapper">

      <div class="zl-ti-text-col">
        {% if section.settings.subheading != blank %}
          <div class="zl-ti-subtitle">{{ section.settings.subheading }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="zl-ti-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="zl-ti-desc">{{ section.settings.description }}</div>
        {% endif %}
      </div>

      <div class="zl-ti-slider-col">
        <div class="zl-ti-swiper swiper js-zl-ti-slider">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide zl-ti-slide" {{ block.shopify_attributes }}>
                <div class="zl-ti-embed-card js-ti-embed-card" data-url="{{ block.settings.social_url }}">
                  <div class="zl-ti-loading-placeholder">
                    <svg class="zl-ti-spinner" viewBox="0 0 50 50">
                      <circle cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    </svg>
                  </div>
                </div>

                {% if block.settings.social_handle != blank %}
                  <div class="zl-ti-handle">
                    <span>@{{ block.settings.social_handle | remove: '@' }}</span>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="zl-ti-bottom-bar">
          <div class="zl-ti-products-scroll">
            {% for block in section.blocks %}
              {% assign product = block.settings.product %}
              {% if product != blank %}
                <div class="zl-ti-product-item">
                  <a href="{{ product.url }}" class="zl-ti-product-link">
                    <div class="zl-ti-prod-img-box">
                      {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
                    </div>

                    <div class="zl-ti-prod-info">
                      <div class="zl-ti-prod-title">{{ product.title }}</div>
                      <div class="zl-ti-prod-price">{{ product.price | money }}</div>
                    </div>

                    <div class="zl-ti-prod-arrow">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }}.zl-ti-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #{{ section_id }} .zl-ti-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #{{ section_id }} .zl-ti-upper-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: 0;
    gap: 40px;
  }

  #{{ section_id }} .zl-ti-text-col {
    flex: 0 0 30%;
    padding-right: 20px;
  }

  #{{ section_id }} .zl-ti-slider-col {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  #{{ section_id }} .zl-ti-subtitle {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
  }

  #{{ section_id }} .zl-ti-heading {
    font-size: 46px;
    line-height: 1.1;
    font-weight: 700;
    margin: 0 0 20px 0;
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .zl-ti-desc {
    font-size: 16px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .zl-ti-swiper {
    overflow: hidden;
    padding: 10px 5px;
    cursor: grab;
  }

  #{{ section_id }} .zl-ti-swiper:active {
    cursor: grabbing;
  }

  #{{ section_id }} .zl-ti-slide {
    width: auto;
    flex-shrink: 0;
  }

  #{{ section_id }} .zl-ti-embed-card {
    position: relative;
    width: 280px;
    height: 500px;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: transform 0.3s ease;
  }

  #{{ section_id }} .zl-ti-embed-card:hover {
    transform: translateY(-5px);
  }

  #{{ section_id }} .zl-ti-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #000;

    /* 核心修复：防止 iframe 吃掉滑动事件 */
    pointer-events: none;
  }

  #{{ section_id }} .zl-ti-loading-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .zl-ti-spinner {
    width: 40px;
    height: 40px;
    animation: zl-spin 1s linear infinite;
    stroke: #999;
  }

  @keyframes zl-spin {
    100% {
      transform: rotate(360deg);
    }
  }

  #{{ section_id }} .zl-ti-handle {
    position: absolute;
    top: 15px;
    left: 15px;
    background: rgba(255,255,255,0.9);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #000;
    z-index: 5;
    pointer-events: none;
  }

  #{{ section_id }} .zl-ti-bottom-bar {
    margin-top: 20px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    padding: 10px 0;
    overflow: hidden;
    border: 1px solid #eee;
    width: 100%;
  }

  #{{ section_id }} .zl-ti-products-scroll {
    display: flex;
    overflow-x: auto;
    gap: 12px;
    padding: 0 15px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #{{ section_id }} .zl-ti-products-scroll::-webkit-scrollbar {
    display: none;
  }

  #{{ section_id }} .zl-ti-product-item {
    flex: 0 0 {{ section.settings.product_card_width }}px;
    background: #f9f9f9;
    border-radius: 8px;
    padding: 8px;
    transition: background 0.2s;
  }

  #{{ section_id }} .zl-ti-product-item:hover {
    background: #f2f2f2;
  }

  #{{ section_id }} .zl-ti-product-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  #{{ section_id }} .zl-ti-prod-img-box {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #eee;
  }

  #{{ section_id }} .zl-ti-prod-img-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #{{ section_id }} .zl-ti-prod-info {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #{{ section_id }} .zl-ti-prod-title {
    font-size: 12px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    line-height: 1.2;
  }

  #{{ section_id }} .zl-ti-prod-price {
    font-size: 11px;
    color: #666;
  }

  #{{ section_id }} .zl-ti-prod-arrow {
    width: 20px;
    height: 20px;
    background: #9887B8;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    #{{ section_id }} .zl-ti-upper-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    #{{ section_id }} .zl-ti-text-col {
      flex: 0 0 100%;
      width: 100%;
      padding-right: 0;
    }

    #{{ section_id }} .zl-ti-slider-col {
      width: 100%;
      margin-right: -20px;
    }

    #{{ section_id }} .zl-ti-embed-card {
      width: 240px;
      height: 420px;
    }

    #{{ section_id }} .zl-ti-bottom-bar {
      margin-left: -20px;
      margin-right: -20px;
      width: auto;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
  }
</style>

<script>
  (function() {
    var root = document.getElementById('{{ section_id }}');
    if (!root) return;

    function getEmbedSrc(url) {
      if (!url) return null;

      if (url.indexOf('instagram.com') !== -1) {
        var cleanUrl = url.split('?')[0].replace(/\/$/, '');
        return cleanUrl + '/embed';
      }

      if (url.indexOf('tiktok.com') !== -1) {
        var match = url.match(/video\/(\d+)/);
        if (match && match[1]) {
          return 'https://www.tiktok.com/embed/v2/' + match[1] + '?lang=en-US';
        }
      }

      return null;
    }

    function buildEmbeds() {
      var cards = root.querySelectorAll('.js-ti-embed-card');

      cards.forEach(function(card) {
        if (card.dataset.loaded === 'true') return;

        var url = card.getAttribute('data-url');
        var src = getEmbedSrc(url);

        if (src) {
          var iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.className = 'zl-ti-iframe';
          iframe.setAttribute('allowfullscreen', 'true');
          iframe.setAttribute('scrolling', 'no');
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('loading', 'lazy');
          iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');

          card.innerHTML = '';
          card.appendChild(iframe);
          card.dataset.loaded = 'true';
        } else {
          card.innerHTML = '<div class="zl-ti-loading-placeholder">Invalid video URL</div>';
          console.warn('ZL Slider: Invalid Social URL', url);
        }
      });
    }

    function loadSwiperAssets() {
      if (window.Swiper) return Promise.resolve();

      if (!document.querySelector('link[data-zl-ti-swiper]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
        link.setAttribute('data-zl-ti-swiper', 'true');
        document.head.appendChild(link);
      }

      return new Promise(function(resolve) {
        var existingScript = document.querySelector('script[data-zl-ti-swiper]');
        if (existingScript) {
          existingScript.addEventListener('load', resolve);
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.setAttribute('data-zl-ti-swiper', 'true');
        script.onload = resolve;
        document.head.appendChild(script);
      });
    }

    function initSlider() {
      var sliderEl = root.querySelector('.js-zl-ti-slider');
      if (!sliderEl || !window.Swiper) return;

      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      new window.Swiper(sliderEl, {
        slidesPerView: 'auto',
        spaceBetween: 20,
        grabCursor: true,
        simulateTouch: true,
        allowTouchMove: true,
        touchStartPreventDefault: false,
        preventClicks: false,
        preventClicksPropagation: false,
        watchOverflow: true,
        resistanceRatio: 0.85,
        breakpoints: {
          320: {
            spaceBetween: 12
          },
          900: {
            spaceBetween: 24
          }
        }
      });
    }

    function initSection() {
      loadSwiperAssets().then(function() {
        buildEmbeds();
        initSlider();
      });
    }

    initSection();

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(event) {
        if (event.target && event.target.id === '{{ section_id }}') {
          root = document.getElementById('{{ section_id }}');
          initSection();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "ZL - TikTok Embed Slider",
  "settings": [
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "range",
      "id": "product_card_width",
      "label": "Product Card Width",
      "min": 150,
      "max": 400,
      "step": 5,
      "default": 220,
      "unit": "px",
      "info": "Adjust this to make product cards smaller or larger."
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DON'T TAKE OUR WORD FOR IT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the tools everyone's talking about"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "default": 1300,
      "unit": "px",
      "label": "Container Width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "embed_slide",
      "name": "Social Video URL",
      "settings": [
        {
          "type": "text",
          "id": "social_url",
          "label": "TikTok or Instagram Video URL",
          "info": "Paste the full link e.g. https://www.tiktok.com/@user/video/..."
        },
        {
          "type": "text",
          "id": "social_handle",
          "label": "Social Handle (Optional)",
          "default": "@username"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked Product",
          "info": "Appears in the bottom bar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZL - TikTok Embed Slider",
      "blocks": [
        {
          "type": "embed_slide"
        },
        {
          "type": "embed_slide"
        }
      ]
    }
  ]
}
{% endschema %}