{% comment %}
  Section: ZL TikTok Embed Slider (Right Aligned Bottom Bar + Resizable Products)
  Description: Embeds social URLs via IFrame. Product bar is inside the slider column.
  Class Naming: zl-ti-*
{% endcomment %}

{%- liquid
  assign section_id = 'zl-ti-' | append: section.id
-%}

<section id="{{ section_id }}" class="zl-ti-section">
  <div class="zl-ti-container">
    
    <div class="zl-ti-upper-wrapper">
      
      <div class="zl-ti-text-col">
        {% if section.settings.subheading != blank %}
          <div class="zl-ti-subtitle">{{ section.settings.subheading }}</div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="zl-ti-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="zl-ti-desc">{{ section.settings.description }}</div>
        {% endif %}
      </div>

      <div class="zl-ti-slider-col">
        
        <div class="zl-ti-swiper swiper js-zl-ti-slider">
          <div class="swiper-wrapper">
            
            {% for block in section.blocks %}
              <div class="swiper-slide zl-ti-slide" {{ block.shopify_attributes }}>
                
                <div class="zl-ti-embed-card js-ti-embed-card" data-url="{{ block.settings.social_url }}">
                  <div class="zl-ti-loading-placeholder">
                    <svg class="zl-ti-spinner" viewBox="0 0 50 50">
                      <circle cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    </svg>
                  </div>
                </div>

                {% if block.settings.social_handle != blank %}
                  <div class="zl-ti-handle">
                    <span>@{{ block.settings.social_handle | remove: '@' }}</span>
                  </div>
                {% endif %}

              </div>
            {% endfor %}

          </div>
          
          <div class="zl-ti-nav-btn zl-ti-prev js-ti-prev" aria-label="Previous video">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </div>

          <div class="zl-ti-nav-btn zl-ti-next js-ti-next" aria-label="Next video">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </div>
         
        </div>

        <div class="zl-ti-bottom-bar">
          <div class="zl-ti-products-scroll">
            {% for block in section.blocks %}
              {% assign product = block.settings.product %}
              {% if product != blank %}
                <div class="zl-ti-product-item">
                  <a href="{{ product.url }}" class="zl-ti-product-link">
                    <div class="zl-ti-prod-img-box">
                      {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
                    </div>
                    <div class="zl-ti-prod-info">
                      <div class="zl-ti-prod-title">{{ product.title }}</div>
                      <div class="zl-ti-prod-price">{{ product.price | money }}</div>
                    </div>
                    <div class="zl-ti-prod-arrow">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }}.zl-ti-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #{{ section_id }} .zl-ti-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Upper Layout */
  #{{ section_id }} .zl-ti-upper-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: 0;
    gap: 40px;
  }

  #{{ section_id }} .zl-ti-text-col {
    flex: 0 0 30%;
    padding-right: 20px;
  }

  #{{ section_id }} .zl-ti-slider-col {
    flex: 1;
    min-width: 0;
    position: relative;
  }

  /* Typography */
  #{{ section_id }} .zl-ti-subtitle {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
  }

  #{{ section_id }} .zl-ti-heading {
    font-size: 46px;
    line-height: 1.1;
    font-weight: 700;
    margin: 0 0 20px 0;
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .zl-ti-desc {
    font-size: 16px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  /* Slider */
  #{{ section_id }} .zl-ti-swiper {
    position: relative;
    overflow: hidden;
    padding: 10px 5px;
  }

  #{{ section_id }} .zl-ti-slide {
    width: auto;
    flex-shrink: 0;
  }

  /* Embed Card */
  #{{ section_id }} .zl-ti-embed-card {
    position: relative;
    width: 325px;
    height: 580px;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    transition: transform 0.3s ease;
  }

  #{{ section_id }} .zl-ti-embed-card:hover {
    transform: translateY(-5px);
  }

  #{{ section_id }} .zl-ti-embed-card.is-tiktok {
    width: 325px;
    height: 580px;
    background: #000;
  }

  #{{ section_id }} .zl-ti-embed-card.is-instagram {
    width: 326px;
    height: 600px;
    background: #fff;
  }

  #{{ section_id }} .zl-ti-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #000;
  }

  #{{ section_id }} .zl-ti-embed-card.is-instagram .zl-ti-iframe {
    background: #fff;
  }

  #{{ section_id }} .zl-ti-loading-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .zl-ti-spinner {
    width: 40px;
    height: 40px;
    animation: zl-spin 1s linear infinite;
    stroke: #999;
  }

  @keyframes zl-spin {
    100% {
      transform: rotate(360deg);
    }
  }

  #{{ section_id }} .zl-ti-handle {
    position: absolute;
    top: 15px;
    left: 15px;
    background: rgba(255,255,255,0.9);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    color: #000;
    z-index: 5;
    pointer-events: none;
  }

  /* Nav Buttons - PC hidden, Mobile visible */
 /* Nav Buttons - PC and Mobile visible */
#{{ section_id }} .zl-ti-nav-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 42px;
  height: 42px;
  background: rgba(255,255,255,0.96);
  border-radius: 50%;
  box-shadow: 0 6px 18px rgba(0,0,0,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 50;
  color: #333;
  transition: all 0.2s ease;
  user-select: none;
  -webkit-user-select: none;
}

#{{ section_id }} .zl-ti-nav-btn:hover {
  background: #fff;
  transform: translateY(-50%) scale(1.06);
}

#{{ section_id }} .zl-ti-nav-btn:active {
  transform: translateY(-50%) scale(0.94);
}

#{{ section_id }} .zl-ti-prev {
  left: 10px;
}

#{{ section_id }} .zl-ti-next {
  right: 10px;
}

#{{ section_id }} .zl-ti-nav-btn.swiper-button-disabled {
  opacity: 0.35;
  pointer-events: none;
}

  @media (max-width: 900px) {
    #{{ section_id }} .evgfhlu1 {
      width: 77%;
    }

    #{{ section_id }} .zl-ti-nav-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 38px;
      height: 38px;
      background: rgba(255,255,255,0.96);
      border-radius: 50%;
      box-shadow: 0 6px 18px rgba(0,0,0,0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 50;
      color: #333;
      transition: all 0.2s ease;
      user-select: none;
      -webkit-user-select: none;
    }

    #{{ section_id }} .zl-ti-nav-btn:active {
      transform: translateY(-50%) scale(0.94);
    }

    #{{ section_id }} .zl-ti-prev {
      left: 10px;
    }

    #{{ section_id }} .zl-ti-next {
      right: 10px;
    }

    #{{ section_id }} .zl-ti-nav-btn.swiper-button-disabled {
      opacity: 0.35;
      pointer-events: none;
    }
  }

  /* Bottom Bar */
  #{{ section_id }} .zl-ti-bottom-bar {
    margin-top: 20px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    padding: 10px 0;
    overflow: hidden;
    border: 1px solid #eee;
    width: 100%;
  }

  #{{ section_id }} .zl-ti-products-scroll {
    display: flex;
    overflow-x: auto;
    gap: 12px;
    padding: 0 15px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #{{ section_id }} .zl-ti-products-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Product Card */
  #{{ section_id }} .zl-ti-product-item {
    flex: 0 0 {{ section.settings.product_card_width }}px;
    background: #f9f9f9;
    border-radius: 8px;
    padding: 8px;
    transition: background 0.2s;
  }

  #{{ section_id }} .zl-ti-product-item:hover {
    background: #f2f2f2;
  }

  #{{ section_id }} .zl-ti-product-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  #{{ section_id }} .zl-ti-prod-img-box {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #eee;
  }

  #{{ section_id }} .zl-ti-prod-img-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #{{ section_id }} .zl-ti-prod-info {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #{{ section_id }} .zl-ti-prod-title {
    font-size: 12px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
    line-height: 1.2;
  }

  #{{ section_id }} .zl-ti-prod-price {
    font-size: 11px;
    color: #666;
  }

  #{{ section_id }} .zl-ti-prod-arrow {
    width: 20px;
    height: 20px;
    background: #9887B8;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    #{{ section_id }} .zl-ti-upper-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    #{{ section_id }} .zl-ti-text-col {
      flex: 0 0 100%;
      width: 100%;
      padding-right: 0;
    }

    #{{ section_id }} .zl-ti-slider-col {
      width: 100%;
      margin-right: -20px;
    }

    #{{ section_id }} .zl-ti-embed-card {
      width: 325px;
      height: 580px;
    }

    #{{ section_id }} .zl-ti-embed-card.is-tiktok {
      width: 325px;
      height: 580px;
    }

    #{{ section_id }} .zl-ti-embed-card.is-instagram {
      width: 326px;
      height: 600px;
    }

    #{{ section_id }} .zl-ti-bottom-bar {
      margin-left: -20px;
      margin-right: -20px;
      width: auto;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
  }

  @media (max-width: 360px) {
    #{{ section_id }} .zl-ti-embed-card,
    #{{ section_id }} .zl-ti-embed-card.is-tiktok {
      width: 310px;
      height: 555px;
    }

    #{{ section_id }} .zl-ti-embed-card.is-instagram {
      width: 310px;
      height: 575px;
    }
  }
</style>

<script>
  (function(){
    var root = document.getElementById('{{ section_id }}');
    if(!root) return;

    function getEmbedSrc(url) {
      if (!url) return null;

      if (url.includes('instagram.com')) {
        var cleanUrl = url.split('?')[0].replace(/\/$/, "");
        return cleanUrl + "/embed";
      }

      if (url.includes('tiktok.com')) {
        var match = url.match(/video\/(\d+)/);
        if (match && match[1]) {
          return "https://www.tiktok.com/embed/v2/" + match[1] + "?lang=en-US";
        }
      }

      return null;
    }

    function buildEmbeds() {
      var cards = root.querySelectorAll('.js-ti-embed-card');

      cards.forEach(function(card) {
        var url = card.getAttribute('data-url') || '';
        var src = getEmbedSrc(url);
        var lowerUrl = url.toLowerCase();

        card.classList.remove('is-tiktok', 'is-instagram');

        if (lowerUrl.includes('tiktok.com')) {
          card.classList.add('is-tiktok');
        }

        if (lowerUrl.includes('instagram.com')) {
          card.classList.add('is-instagram');
        }

        if (src) {
          var iframe = document.createElement('iframe');
          iframe.src = src;
          iframe.className = 'zl-ti-iframe';
          iframe.setAttribute('allowfullscreen', 'true');
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('loading', 'lazy');
          iframe.setAttribute('title', 'Embedded social video');
          iframe.setAttribute('allow', 'encrypted-media; picture-in-picture; fullscreen');

          card.innerHTML = '';
          card.appendChild(iframe);
        } else {
          console.warn('ZL Slider: Invalid Social URL', url);
        }
      });
    }

    function loadSwiperAssets() {
      if(window.Swiper) return Promise.resolve();

      if (!document.querySelector('link[data-zl-swiper-css="true"]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
        link.setAttribute('data-zl-swiper-css', 'true');
        document.head.appendChild(link);
      }

      var existingScript = document.querySelector('script[data-zl-swiper-js="true"]');

      if (existingScript) {
        return new Promise(function(resolve) {
          if (window.Swiper) {
            resolve();
          } else {
            existingScript.addEventListener('load', resolve);
          }
        });
      }

      return new Promise(function(resolve) {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.setAttribute('data-zl-swiper-js', 'true');
        script.onload = resolve;
        document.head.appendChild(script);
      });
    }

    function initSlider() {
      var sliderEl = root.querySelector('.js-zl-ti-slider');
      var prevBtn = root.querySelector('.js-ti-prev');
      var nextBtn = root.querySelector('.js-ti-next');

      if(!sliderEl || !window.Swiper) return;

      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      new window.Swiper(sliderEl, {
        slidesPerView: 'auto',
        spaceBetween: 20,
        grabCursor: true,
        watchOverflow: true,
        observer: true,
        observeParents: true,
        resizeObserver: true,
        navigation: {
          nextEl: nextBtn,
          prevEl: prevBtn
        },
        breakpoints: {
          320: {
            spaceBetween: 12
          },
          900: {
            spaceBetween: 24
          }
        },
        on: {
          init: function(swiper) {
            setTimeout(function() {
              swiper.update();
            }, 300);
          },
          resize: function(swiper) {
            swiper.update();
          }
        }
      });
    }

    loadSwiperAssets().then(function(){
      buildEmbeds();
      initSlider();
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if(e.target && e.target.id === '{{ section_id }}') {
          root = document.getElementById('{{ section_id }}');
          if(!root) return;

          loadSwiperAssets().then(function(){
            buildEmbeds();
            initSlider();
          });
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "ZL - TikTok Embed Slider",
  "settings": [
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "range",
      "id": "product_card_width",
      "label": "Product Card Width",
      "min": 150,
      "max": 400,
      "step": 5,
      "default": 220,
      "unit": "px",
      "info": "Adjust this to make product cards smaller or larger."
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "DON'T TAKE OUR WORD FOR IT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the tools everyone's talking about"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "default": 1300,
      "unit": "px",
      "label": "Container Width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "embed_slide",
      "name": "Social Video URL",
      "settings": [
        {
          "type": "text",
          "id": "social_url",
          "label": "TikTok or Instagram Video URL",
          "info": "Paste the full link e.g. https://www.tiktok.com/@user/video/..."
        },
        {
          "type": "text",
          "id": "social_handle",
          "label": "Social Handle (Optional)",
          "default": "@username"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Linked Product",
          "info": "Appears in the bottom bar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZL - TikTok Embed Slider",
      "blocks": [
        {
          "type": "embed_slide"
        },
        {
          "type": "embed_slide"
        }
      ]
    }
  ]
}
{% endschema %}