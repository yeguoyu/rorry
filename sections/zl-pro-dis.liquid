<div id="zl-dis-wrapper-{{ section.id }}">
  <section id="zl-dis-{{ section.id }}" class="zl-dis-section">
    <div class="zl-dis-bg">
      <picture>
        {%- if section.settings.image_mb != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mb | image_url: width: 750 }}">
        {%- endif -%}
        {%- if section.settings.image_pc != blank -%}
          <img src="{{ section.settings.image_pc | image_url: width: 1920 }}" alt="" loading="lazy">
        {%- endif -%}
      </picture>
    </div>

    <div class="zl-dis-container">
      <div class="zl-dis-text-wrap">
        {%- if section.settings.title != blank -%}
          <h2 class="zl-dis-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="zl-dis-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="zl-dis-timer-wrap" data-endtime="{{ section.settings.end_time }}">
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-days">00</span>
          <span class="zl-dis-label">DAYS</span>
        </div>
        <span class="zl-dis-colon">:</span>
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-hours">00</span>
          <span class="zl-dis-label">HOURS</span>
        </div>
      </div>

      <div class="zl-dis-form-wrap">
        {% form 'customer', class: 'zl-dis-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="zl-dis-input-group">
            <input 
              type="email" 
              name="contact[email]" 
              class="zl-dis-input" 
              placeholder="{{ section.settings.input_placeholder | default: 'Enter your email' }}" 
              required
              aria-label="Email address"
            >
            <button type="submit" class="zl-dis-btn" aria-label="Submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="zl-dis-form-success">{{ section.settings.success_message | default: 'Thanks for subscribing!' }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="zl-dis-form-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </section>
</div>

<style>
  #zl-dis-wrapper-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_pc }}px;
    padding-bottom: {{ section.settings.padding_bottom_pc }}px;
  }

  #zl-dis-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_pc }}px;
    background-color: {{ section.settings.bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #zl-dis-{{ section.id }} .zl-dis-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #zl-dis-{{ section.id }} .zl-dis-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #zl-dis-{{ section.id }} .zl-dis-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    width: 100%;
    max-width: 1200px;
    padding: 0 20px;
  }

  #zl-dis-{{ section.id }} .zl-dis-text-wrap {
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #zl-dis-{{ section.id }} .zl-dis-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_pc }}px;
    font-weight: {{ section.settings.title_weight }};
    margin: 0;
    line-height: 1.2;
  }

  #zl-dis-{{ section.id }} .zl-dis-subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_pc }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    margin: 4px 0 0 0;
    line-height: 1.2;
  }

  #zl-dis-{{ section.id }} .zl-dis-timer-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #zl-dis-{{ section.id }} .zl-dis-timer-box {
    background-color: {{ section.settings.timer_bg }};
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 60px;
    padding: 6px 10px;
  }

  #zl-dis-{{ section.id }} .zl-dis-time {
    color: {{ section.settings.time_color }};
    font-size: {{ section.settings.time_size_pc }}px;
    font-weight: {{ section.settings.time_weight }};
    line-height: 1.1;
  }

  #zl-dis-{{ section.id }} .zl-dis-label {
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: {{ section.settings.label_weight }};
    line-height: 1;
    margin-top: 4px;
    text-transform: uppercase;
  }

  #zl-dis-{{ section.id }} .zl-dis-colon {
    color: {{ section.settings.colon_color }};
    font-size: {{ section.settings.time_size_pc }}px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 15px;
  }

  /* --- 新增订阅表单样式 --- */
  #zl-dis-{{ section.id }} .zl-dis-form-wrap {
    width: 100%;
    max-width: 300px;
  }

  #zl-dis-{{ section.id }} .zl-dis-form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  #zl-dis-{{ section.id }} .zl-dis-input-group {
    display: flex;
    align-items: center;
    width: 100%;
    height: 48px;
    background-color: {{ section.settings.input_bg }};
    border-radius: 40px;
    padding: 4px 6px 4px 20px;
  }

  #zl-dis-{{ section.id }} .zl-dis-input {
    flex-grow: 1;
    height: 100%;
    background: transparent;
    border: none;
    color: {{ section.settings.input_color }};
    font-size: 14px;
    outline: none;
    padding: 0;
    box-shadow: none;
  }

  #zl-dis-{{ section.id }} .zl-dis-input::placeholder {
    color: {{ section.settings.input_color }};
    opacity: 0.8;
  }

  #zl-dis-{{ section.id }} .zl-dis-btn {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease, opacity 0.3s ease;
    padding: 0;
  }

  #zl-dis-{{ section.id }} .zl-dis-btn svg {
    width: 18px;
    height: 18px;
  }

  #zl-dis-{{ section.id }} .zl-dis-btn:hover {
    transform: scale(1.05);
    opacity: 0.9;
  }

  #zl-dis-{{ section.id }} .zl-dis-form-success {
    color: #fff;
    font-size: 12px;
    margin: 8px 0 0 0;
    text-align: left;
  }

  #zl-dis-{{ section.id }} .zl-dis-form-error {
    color: red;
    font-size: 12px;
    margin: 8px 0 0 0;
    text-align: left;
  }

  @media screen and (max-width: 768px) {
    #zl-dis-wrapper-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    #zl-dis-{{ section.id }} {
      height: {{ section.settings.height_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-container {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }

    #zl-dis-{{ section.id }} .zl-dis-text-wrap {
      text-align: center;
    }

    #zl-dis-{{ section.id }} .zl-dis-title {
      font-size: {{ section.settings.title_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-subtitle {
      font-size: {{ section.settings.subtitle_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-timer-wrap {
      gap: 5px;
    }

    #zl-dis-{{ section.id }} .zl-dis-timer-box {
      min-width: 50px;
      padding: 5px 8px;
    }

    #zl-dis-{{ section.id }} .zl-dis-time {
      font-size: {{ section.settings.time_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-label {
      font-size: {{ section.settings.label_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-colon {
      font-size: {{ section.settings.time_size_mb }}px;
      margin-bottom: 12px;
    }

    #zl-dis-{{ section.id }} .zl-dis-form-wrap {
      max-width: 100%;
      padding: 0 10px;
    }

    #zl-dis-{{ section.id }} .zl-dis-input-group {
      height: 44px;
      padding: 4px 5px 4px 15px;
    }

    #zl-dis-{{ section.id }} .zl-dis-btn {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const section = document.getElementById('zl-dis-{{ section.id }}');
  if (!section) return;

  const timerWrap = section.querySelector('.zl-dis-timer-wrap');
  const endTimeStr = timerWrap.getAttribute('data-endtime');
  if (!endTimeStr) return;

  const targetDate = new Date(endTimeStr.replace(/-/g, "/")).getTime();
  const daysEl = section.querySelector('.zl-dis-days');
  const hoursEl = section.querySelector('.zl-dis-hours');

  function updateTimer() {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      if(daysEl) daysEl.innerText = "00";
      if(hoursEl) hoursEl.innerText = "00";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));

    if(daysEl) daysEl.innerText = days < 10 ? "0" + days : days;
    if(hoursEl) hoursEl.innerText = hours < 10 ? "0" + hours : hours;
  }

  updateTimer();
  setInterval(updateTimer, 60000); // 因为只显示到小时，一分钟更新一次即可
});
</script>

