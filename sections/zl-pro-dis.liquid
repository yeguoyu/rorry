{%- style -%}
  #zl-dis-wrapper-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_pc }}px;
    padding-bottom: {{ section.settings.padding_bottom_pc }}px;
  }

  #zl-dis-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_pc }}px;
    background-color: {{ section.settings.bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #zl-dis-{{ section.id }} .zl-dis-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #zl-dis-{{ section.id }} .zl-dis-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #zl-dis-{{ section.id }} .zl-dis-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    width: 100%;
    max-width: 1200px;
    padding: 0 20px;
  }

  #zl-dis-{{ section.id }} .zl-dis-text-wrap {
    text-align: right;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #zl-dis-{{ section.id }} .zl-dis-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_pc }}px;
    font-weight: {{ section.settings.title_weight }};
    margin: 0;
    line-height: 1.2;
  }

  #zl-dis-{{ section.id }} .zl-dis-subtitle {
    color: {{ section.settings.subtitle_color }};
    font-size: {{ section.settings.subtitle_size_pc }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    margin: 4px 0 0 0;
    line-height: 1.2;
  }

  #zl-dis-{{ section.id }} .zl-dis-timer-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #zl-dis-{{ section.id }} .zl-dis-timer-box {
    background-color: {{ section.settings.timer_bg }};
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 50px;
    padding: 4px 8px;
  }

  #zl-dis-{{ section.id }} .zl-dis-time {
    color: {{ section.settings.time_color }};
    font-size: {{ section.settings.time_size_pc }}px;
    font-weight: {{ section.settings.time_weight }};
    line-height: 1.1;
  }

  #zl-dis-{{ section.id }} .zl-dis-label {
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: {{ section.settings.label_weight }};
    line-height: 1;
    margin-top: 2px;
    text-transform: uppercase;
  }

  #zl-dis-{{ section.id }} .zl-dis-colon {
    color: {{ section.settings.colon_color }};
    font-size: {{ section.settings.time_size_pc }}px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 10px;
  }

  #zl-dis-{{ section.id }} .zl-dis-btn {
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    font-size: {{ section.settings.btn_size_pc }}px;
    font-weight: {{ section.settings.btn_weight }};
    padding: 10px 30px;
    border-radius: {{ section.settings.btn_radius }}px;
    text-decoration: none;
    transition: opacity 0.3s;
    display: inline-block;
  }

  #zl-dis-{{ section.id }} .zl-dis-btn:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 768px) {
    #zl-dis-wrapper-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    #zl-dis-{{ section.id }} {
      height: {{ section.settings.height_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-container {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }

    #zl-dis-{{ section.id }} .zl-dis-text-wrap {
      text-align: center;
    }

    #zl-dis-{{ section.id }} .zl-dis-title {
      font-size: {{ section.settings.title_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-subtitle {
      font-size: {{ section.settings.subtitle_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-timer-wrap {
      gap: 5px;
    }

    #zl-dis-{{ section.id }} .zl-dis-timer-box {
      min-width: 45px;
      padding: 4px;
    }

    #zl-dis-{{ section.id }} .zl-dis-time {
      font-size: {{ section.settings.time_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-label {
      font-size: {{ section.settings.label_size_mb }}px;
    }

    #zl-dis-{{ section.id }} .zl-dis-colon {
      font-size: {{ section.settings.time_size_mb }}px;
      margin-bottom: 8px;
    }

    #zl-dis-{{ section.id }} .zl-dis-btn {
      font-size: {{ section.settings.btn_size_mb }}px;
      padding: 8px 24px;
    }
  }
{%- endstyle -%}

<div id="zl-dis-wrapper-{{ section.id }}">
  <section id="zl-dis-{{ section.id }}" class="zl-dis-section">
    <div class="zl-dis-bg">
      <picture>
        {%- if section.settings.image_mb != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mb | image_url: width: 750 }}">
        {%- endif -%}
        {%- if section.settings.image_pc != blank -%}
          <img src="{{ section.settings.image_pc | image_url: width: 1920 }}" alt="" loading="lazy">
        {%- endif -%}
      </picture>
    </div>

    <div class="zl-dis-container">
      <div class="zl-dis-text-wrap">
        {%- if section.settings.title != blank -%}
          <h2 class="zl-dis-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="zl-dis-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="zl-dis-timer-wrap" data-endtime="{{ section.settings.end_time }}">
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-days">00</span>
          <span class="zl-dis-label">DAYS</span>
        </div>
        <span class="zl-dis-colon">:</span>
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-hours">00</span>
          <span class="zl-dis-label">HOURS</span>
        </div>
        {% comment %} <span class="zl-dis-colon">:</span>
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-mins">00</span>
          <span class="zl-dis-label">MINS</span>
        </div>
        <span class="zl-dis-colon">:</span>
        <div class="zl-dis-timer-box">
          <span class="zl-dis-time zl-dis-secs">00</span>
          <span class="zl-dis-label">SECS</span>
        </div> {% endcomment %}
      </div>

      {%- if section.settings.btn_text != blank -%}
        <a href="#buymap" class="zl-dis-btn">{{ section.settings.btn_text }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const section = document.getElementById('zl-dis-{{ section.id }}');
  if (!section) return;

  const btn = section.querySelector('.zl-dis-btn');
  if (btn && btn.getAttribute('href').startsWith('#')) {
    btn.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      const targetElement = document.querySelector(targetId);
      
      if (targetElement) {
        e.preventDefault();
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  }

  const timerWrap = section.querySelector('.zl-dis-timer-wrap');
  const endTimeStr = timerWrap.getAttribute('data-endtime');
  if (!endTimeStr) return;

  const targetDate = new Date(endTimeStr.replace(/-/g, "/")).getTime();
  const daysEl = section.querySelector('.zl-dis-days');
  const hoursEl = section.querySelector('.zl-dis-hours');
  const minsEl = section.querySelector('.zl-dis-mins');
  const secsEl = section.querySelector('.zl-dis-secs');

  function updateTimer() {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      daysEl.innerText = "00";
      hoursEl.innerText = "00";
      minsEl.innerText = "00";
      secsEl.innerText = "00";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    daysEl.innerText = days < 10 ? "0" + days : days;
    hoursEl.innerText = hours < 10 ? "0" + hours : hours;
    minsEl.innerText = minutes < 10 ? "0" + minutes : minutes;
    secsEl.innerText = seconds < 10 ? "0" + seconds : seconds;
  }

  updateTimer();
  setInterval(updateTimer, 1000);
});
</script>

