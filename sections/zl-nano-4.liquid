{%- style -%}
  .zl-tri-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .zl-tri-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .zl-tri-grid {
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: {{ section.settings.gap_pc }}px;
  }

  .zl-tri-card {
    position: relative;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    display: flex;
    text-decoration: none;
    transform: translateZ(0);
    box-sizing: border-box;
  }

  .zl-tri-bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: #1a1a1a;
  }

  .zl-tri-picture {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .zl-tri-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zl-tri-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    width: 100%;
    height: 100%;
    padding: 32px;
    box-sizing: border-box;
  }

  .zl-tri-title {
    margin: 0;
    line-height: 1.2;
  }
  .zl-tri-container-last-title{
    color:#fff;
    font-size:20px;
    margin-top:16px;
    text-align:end;
  }

  {%- for block in section.blocks -%}
    .zl-tri-card-{{ block.id }} {
      grid-column: span {{ block.settings.col_span_pc | times: 2 | round }};
      height: {{ block.settings.height_pc }}px !important;
      padding-bottom: {{ block.settings.height_pc }}px !important;
    }
    
    .zl-tri-title-{{ block.id }} {
      font-size: {{ block.settings.title_size_pc }}px;
      color: {{ block.settings.title_color }};
      font-weight: {{ block.settings.title_weight }};
    }
  {%- endfor -%}

  @media screen and (max-width: 1024px) {
    .zl-tri-content {
      padding: 24px;
    }
  }

  @media screen and (max-width: 768px) {
    .zl-tri-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    .zl-tri-container {
      padding: 0 12px;
    }

    .zl-tri-grid {
      gap: {{ section.settings.gap_mb }}px;
    }

    .zl-tri-content {
      padding: 16px;
    }

    {%- for block in section.blocks -%}
      .zl-tri-card-{{ block.id }} {
        grid-column: span {{ block.settings.col_span_mb | times: 2 | round }};
        height: {{ block.settings.height_mb }}px !important;
        padding-bottom: {{ block.settings.height_mb }}px !important;
      }
      
      .zl-tri-title-{{ block.id }} {
        font-size: {{ block.settings.title_size_mb }}px;
      }
    {%- endfor -%}
  }
{%- endstyle -%}

<section class="zl-tri-section-{{ section.id }}">
  <div class="zl-tri-container">
    <div class="zl-tri-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign align_items = 'center'
          assign justify_content = 'center'
          assign text_align = 'center'

          case block.settings.content_position
            when 'top-left'
              assign align_items = 'flex-start'
              assign justify_content = 'flex-start'
              assign text_align = 'left'
            when 'top-center'
              assign align_items = 'center'
              assign justify_content = 'flex-start'
            when 'top-right'
              assign align_items = 'flex-end'
              assign justify_content = 'flex-start'
              assign text_align = 'right'
            when 'center-left'
              assign align_items = 'flex-start'
              assign justify_content = 'center'
              assign text_align = 'left'
            when 'center-center'
              assign align_items = 'center'
              assign justify_content = 'center'
            when 'center-right'
              assign align_items = 'flex-end'
              assign justify_content = 'center'
              assign text_align = 'right'
            when 'bottom-left'
              assign align_items = 'flex-start'
              assign justify_content = 'flex-end'
              assign text_align = 'left'
            when 'bottom-center'
              assign align_items = 'center'
              assign justify_content = 'flex-end'
            when 'bottom-right'
              assign align_items = 'flex-end'
              assign justify_content = 'flex-end'
              assign text_align = 'right'
          endcase
        -%}

        <a href="{{ block.settings.link | default: '#' }}" class="zl-tri-card zl-tri-card-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="zl-tri-bg-wrap">
            <picture class="zl-tri-picture">
              {%- if block.settings.image_mb != blank -%}
                <source media="(max-width: 390px)" srcset="{{ block.settings.image_mb | image_url: width: 780 }}">
                <source media="(max-width: 767px)" srcset="{{ block.settings.image_mb | image_url: width: 1534 }}">
              {%- elsif block.settings.image_pc != blank -%}
                <source media="(max-width: 390px)" srcset="{{ block.settings.image_pc | image_url: width: 780 }}">
                <source media="(max-width: 767px)" srcset="{{ block.settings.image_pc | image_url: width: 1534 }}">
              {%- endif -%}
              
              {%- if block.settings.image_pc != blank -%}
                <source media="(max-width: 1024px)" srcset="{{ block.settings.image_pc | image_url: width: 2048 }}">
                <source media="(max-width: 1439px)" srcset="{{ block.settings.image_pc | image_url: width: 2878 }}">
                <source media="(max-width: 1919px)" srcset="{{ block.settings.image_pc | image_url: width: 3838 }}">
                <img decoding="async" src="{{ block.settings.image_pc | image_url: width: 3840 }}" loading="lazy" alt="{{ block.settings.title | escape }}" class="zl-tri-img">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'zl-tri-img' }}
              {%- endif -%}
            </picture>
          </div>

          {%- if block.settings.title != blank -%}
            <div class="zl-tri-content" style="align-items: {{ justify_content }}; justify-content: {{ align_items }}; text-align: {{ text_align }};">
              <h3 class="zl-tri-title zl-tri-title-{{ block.id }}">{{ block.settings.title | newline_to_br }}</h3>
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    <p class="zl-tri-container-last-title">Tested in RORRY Lab; results may vary</p>
  </div>
  
</section>

{% schema %}
{
  "name": "ZL Tri Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1440
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_pc",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (PC)",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_mb",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Grid Gap (Mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Top (PC)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Bottom (PC)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "grid_card",
      "name": "Grid Card",
      "settings": [
        {
          "type": "header",
          "content": "Sizing (12-Column Grid)"
        },
        {
          "type": "range",
          "id": "col_span_pc",
          "min": 1,
          "max": 12,
          "step": 0.5,
          "label": "Width Span (PC)",
          "info": "12 is full width, 6 is half, 4 is one-third, 3 is one-fourth.",
          "default": 6
        },
        {
          "type": "range",
          "id": "col_span_mb",
          "min": 1,
          "max": 12,
          "step": 0.5,
          "label": "Width Span (Mobile)",
          "default": 12
        },
        {
          "type": "range",
          "id": "height_pc",
          "min": 100,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Exact Height (PC)",
          "default": 320
        },
        {
          "type": "range",
          "id": "height_mb",
          "min": 100,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Exact Height (Mobile)",
          "default": 240
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image_pc",
          "label": "Image (PC)"
        },
        {
          "type": "image_picker",
          "id": "image_mb",
          "label": "Image (Mobile)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        },
        {
          "type": "header",
          "content": "Text Content"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "Card Title"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content Position",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "top-right", "label": "Top Right" },
            { "value": "center-left", "label": "Middle Left" },
            { "value": "center-center", "label": "Middle Center" },
            { "value": "center-right", "label": "Middle Right" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ],
          "default": "top-left"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "title_size_pc",
          "min": 12,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Title Size (PC)",
          "default": 24
        },
        {
          "type": "range",
          "id": "title_size_mb",
          "min": 12,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Title Size (Mobile)",
          "default": 18
        },
        {
          "type": "select",
          "id": "title_weight",
          "label": "Title Weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "600"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZL Tri Grid",
      "blocks": [
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 6,
            "col_span_mb": 12,
            "height_pc": 320,
            "height_mb": 240,
            "title": "Triple Display with One Stable 8K Output",
            "title_size_pc": 24,
            "title_size_mb": 20
          }
        },
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 3,
            "col_span_mb": 6,
            "height_pc": 320,
            "height_mb": 240,
            "title": "All-Round Connectivity",
            "title_size_pc": 20,
            "title_size_mb": 16
          }
        },
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 3,
            "col_span_mb": 6,
            "height_pc": 320,
            "height_mb": 240,
            "title": "140W Power for Your MacBook",
            "title_size_pc": 20,
            "title_size_mb": 16
          }
        },
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 6,
            "col_span_mb": 12,
            "height_pc": 320,
            "height_mb": 240,
            "title": "Active Cooling Fan",
            "title_size_pc": 24,
            "title_size_mb": 20
          }
        },
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 3,
            "col_span_mb": 6,
            "height_pc": 320,
            "height_mb": 240,
            "title": "Built-In Power for a Tidy Desk",
            "title_size_pc": 20,
            "title_size_mb": 16
          }
        },
        {
          "type": "grid_card",
          "settings": {
            "col_span_pc": 3,
            "col_span_mb": 6,
            "height_pc": 320,
            "height_mb": 240,
            "title": "Smart Display and Control via App",
            "title_size_pc": 20,
            "title_size_mb": 16
          }
        }
      ]
    }
  ]
}
{% endschema %}