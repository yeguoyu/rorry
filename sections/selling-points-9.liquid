
<style>
  #shopify-section-{{section.id}} .selling_points_9{
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent{
    width: 90%;
    margin: 0 auto;
    max-width: 1320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    {% comment %} padding: 0 5rem; {% endcomment %}
    max-width: var(--page-width);
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent>.title{
    margin: 0;
    width: 100%;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size | times: 0.8 | round: 0 }}px;
    line-height: 1.1;
    font-weight: 700;
    text-align: center;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent>.title *{
    margin: 0;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list{
    width: 100%;
    {% comment %} max-width: 920px; {% endcomment %}
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{
    display: grid;
    grid-template-columns: minmax(160px, 220px) minmax(0, 1fr);
    align-items: center;
    column-gap: 26px;
    padding: 14px 28px;
    min-height: 80px;
    border-radius: 0;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item:nth-of-type(odd){
    background: #f2f2f4;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item:nth-of-type(even){
    background: #ffffff;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .title{
    margin: 0;
    font-weight: 600;
    line-height: 1.35;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details{
    margin: 0;
    line-height: 1.45;
    color: #6b6b6b;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details p{
    margin: 0;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details p + p{
    margin-top: 6px;
  }
  {% if template.suffix == 'p50-colorful' %}
  #shopify-section-{{section.id}} .selling_points_9 .centent>.title,
  #shopify-section-{{section.id}} .selling_points_9 .centent>.title *{
    font-size: 36px !important;
  }
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .title,
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details,
  #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details p{
    font-size: 18px !important;
  }
  {% endif %}




  @media screen and (max-width: 750px) {
    #shopify-section-{{section.id}} .selling_points_9{
      padding-top: {{ section.settings.mobile_padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom | times: 0.75 | round: 0 }}px;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent{
      width: 100%;
      padding: 0 14px;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent>.title{
      font-size: {{ section.settings.mobile_title_size | times: 0.8 | round: 0 }}px;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent .list{
      margin-top: 24px;
      gap: 0;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{
      grid-template-columns: minmax(98px, 38%) minmax(0, 1fr);
      column-gap: 12px;
      padding: 12px 14px;
      align-items: center;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .title{
      line-height: 1.3;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details{
      line-height: 1.35;
    }
    {% if template.suffix == 'p50-colorful' %}
    #shopify-section-{{section.id}} .selling_points_9 .centent>.title,
    #shopify-section-{{section.id}} .selling_points_9 .centent>.title *{
      font-size: 20px !important;
    }
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .title,
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details,
    #shopify-section-{{section.id}} .selling_points_9 .centent .list .item .details p{
      font-size: 12px !important;
    }
    {% endif %}
  }

</style>


<div class="selling_points_9" name="{{ section.settings.sectionname }}">
  <div class="centent">
    <div class="title common-transform-show-p50">{{ section.settings.title }}</div>
    <div class="list" role="table" aria-label="Tech specs">
      {% for item in section.blocks %}
        <div class="item item{{ forloop.index }}" role="row">
          <div class="title" role="cell">{{ item.settings.title }}</div>
          <div class="details" role="cell">{{ item.settings.details }}</div>
        </div>
        <style>
           #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{{ forloop.index }} .title{
             color:{{item.settings.title_color}};
             font-size:{{item.settings.title_size | times: 0.8 | round: 0}}px;
           }
          #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{{ forloop.index }} .details{
            color:{{item.settings.details_color}};
             font-size:{{item.settings.details_size | times: 0.8 | round: 0}}px;
            word-break: break-word;
             flex: 1;
          }
          @media screen and (max-width: 750px) {
            #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{{ forloop.index }} .title{
              font-size:{{item.settings.mobile_title_size | times: 0.8 | round: 0}}px;
              line-height: 1.3;
            }
            #shopify-section-{{section.id}} .selling_points_9 .centent .list .item{{ forloop.index }} .details{
              font-size:{{item.settings.mobile_details_size | times: 0.8 | round: 0}}px;
              word-break: break-word;
            }
          }
        </style>
      {% endfor %}
    </div>
    
  </div>
</div>


{% schema %}
  {
    "name": "selling points 9",
    "settings": [
      {
      "type": "text",
        "id": "sectionname",
        "label": "section name"
      },
     {
      "type": "color",
      "id": "background",
      "label": "background"
    },
      
    {
      "type": "richtext",
      "id": "title",
      "label": "title"
    },
    {
    "type": "range",
    "id": "title_size",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "px",
    "label": "title_size",
    "default": 64
  },
    {
    "type": "range",
    "id": "mobile_title_size",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "px",
    "label": "mobile_title_size",
    "default": 24
  },
    
    {
      "type": "color",
      "id": "title_color",
      "label": "title_color"
    },
      {
      "type": "color",
      "id": "border_color",
        "info": "分割线颜色",
        "default": "#fff",
      "label": "border_color"
    },
      {
    "type": "header",
    "content": "t:sections.all.padding.section_padding_heading"
  },
  {
    "type": "range",
    "id": "padding_top",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "t:sections.all.padding.padding_top",
    "default": 36
  },
  {
    "type": "range",
    "id": "padding_bottom",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "t:sections.all.padding.padding_bottom",
    "default": 36
  },
    {
    "type": "range",
    "id": "mobile_padding_top",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "mobile 顶部填充",
    "default": 36
  },
  {
    "type": "range",
    "id": "mobile_padding_bottom",
    "min": 0,
    "max": 100,
    "step": 4,
    "unit": "px",
    "label": "mobile 底部填充",
    "default": 36
  }
    ],
  "blocks": [
    {
      "type": "item_block",
      "name": "item_block",
      "settings": [
        {
      "type": "inline_richtext",
      "id": "title",
      "label": "title"
    },
          {
      "type": "color",
      "id": "title_color",
      "label": "title_color"
    },
    {
    "type": "range",
    "id": "title_size",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "px",
    "label": "title_size",
    "default": 64
  },
    {
    "type": "range",
    "id": "mobile_title_size",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "px",
    "label": "mobile_title_size",
    "default": 24
  },
          {
        "type": "inline_richtext",
        "id": "details",
        "label": "details"
      },
          {
            "type": "color",
            "id": "details_color",
            "label": "details_color"
          },
      {
            "type": "range",
            "id": "details_size",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "details_size",
            "default": 24
          },
          {
            "type": "range",
            "id": "mobile_details_size",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "details_size",
            "default": 14
          }
      ]
    }
  ],
    "presets": [{"name": "selling points 9"}]
  }
{% endschema %}