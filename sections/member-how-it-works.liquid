{%- style -%}
  .member-steps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }

  .member-steps-{{ section.id }} .member-steps__wrap {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-padding, 20px);
  }

  .member-steps-{{ section.id }} .member-steps__heading {
    margin: 0 0 40px;
    text-align: center;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: {{ section.settings.color_text }};
    letter-spacing: -0.02em;
  }

  .member-steps-{{ section.id }} .member-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
    justify-items: center;
  }

  @media screen and (min-width: 768px) {
    .member-steps-{{ section.id }} .member-steps__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .member-steps-{{ section.id }} .member-step {
    width: 100%;
    max-width: {{ section.settings.icon_max_width }}px;
    margin: 0 auto;
  }

  .member-steps-{{ section.id }} .member-step__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .member-steps-{{ section.id }} .member-step__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    max-width: {{ section.settings.icon_max_width }}px;
    margin: 0 auto;
    border: 1px dashed rgba(92, 77, 120, 0.25);
    border-radius: 12px;
    background: rgba(152, 135, 184, 0.06);
    color: rgba(92, 77, 120, 0.45);
    font-size: 13px;
    text-align: center;
    padding: 16px;
  }
{%- endstyle -%}

<div id="{{ section.settings.anchor_id | default: 'member-how-it-works' }}" class="member-steps-section member-steps-{{ section.id }}">
  <div class="member-steps__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="member-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="member-steps__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="member-step" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'member-step__image',
                    alt: block.settings.image.alt | default: block.settings.alt | escape
                -}}
              {%- else -%}
                <div class="member-step__placeholder">Upload step {{ forloop.index }} icon</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="member-step"><div class="member-step__placeholder">Upload step 1 icon</div></div>
        <div class="member-step"><div class="member-step__placeholder">Upload step 2 icon</div></div>
        <div class="member-step"><div class="member-step__placeholder">Upload step 3 icon</div></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Member how it works",
  "class": "member-section member-section--steps",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "member-how-it-works",
      "info": "Used by sticky navigation."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Heading color",
      "default": "#5c4d78"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_max_width",
      "min": 80,
      "max": 480,
      "step": 10,
      "unit": "px",
      "label": "Icon max width",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step icon",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Optional. Used if the image has no alt text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Member how it works",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  }
}
{% endschema %}
