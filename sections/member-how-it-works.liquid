{%- style -%}
  .member-steps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
    color: {{ section.settings.color_text }};
  }

  .member-steps-{{ section.id }} .member-steps__wrap {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-padding, 20px);
  }

  .member-steps-{{ section.id }} .member-steps__heading {
    margin: 0 0 40px;
    text-align: center;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: {{ section.settings.color_text }};
    letter-spacing: -0.02em;
  }

  .member-steps-{{ section.id }} .member-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 768px) {
    .member-steps-{{ section.id }} .member-steps__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .member-steps-{{ section.id }} .member-step {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .member-steps-{{ section.id }} .member-step__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    margin-bottom: 18px;
    border-radius: 16px;
    font-size: 32px;
    line-height: 1;
  }

  .member-steps-{{ section.id }} .member-step__icon img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .member-steps-{{ section.id }} .member-step__title {
    margin: 0 0 10px;
    font-size: 18px;
    font-weight: 700;
    color: {{ section.settings.color_text }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .member-steps-{{ section.id }} .member-step__text {
    margin: 0;
    max-width: 280px;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(92, 77, 120, 0.88);
  }

  .member-steps-{{ section.id }} .member-step__icon span {
    color: {{ section.settings.color_text }};
  }
{%- endstyle -%}

<div id="{{ section.settings.anchor_id | default: 'member-how-it-works' }}" class="member-steps-section member-steps-{{ section.id }}">
  <div class="member-steps__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="member-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="member-steps__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <article class="member-step" {{ block.shopify_attributes }}>
              <div class="member-step__icon" style="background: {{ block.settings.icon_bg | default: '#f5e6a8' }};">
                {%- if block.settings.icon_image != blank -%}
                  {{- block.settings.icon_image | image_url: width: 72 | image_tag: loading: 'lazy', alt: block.settings.title -}}
                {%- else -%}
                  <span aria-hidden="true">{{ block.settings.icon_emoji | default: '🎁' }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="member-step__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="member-step__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <article class="member-step">
          <div class="member-step__icon" style="background:#f5e6a8;"><span aria-hidden="true">🎁</span></div>
          <h3 class="member-step__title">JOIN</h3>
          <p class="member-step__text">Register for free and get 100 points immediately.</p>
        </article>
        <article class="member-step">
          <div class="member-step__icon" style="background:#d4edda;"><span aria-hidden="true">⏱</span></div>
          <h3 class="member-step__title">EARN</h3>
          <p class="member-step__text">Earn points for every dollar spent on rorry.com.</p>
        </article>
        <article class="member-step">
          <div class="member-step__icon" style="background:#f8d7e8;"><span aria-hidden="true">🎟</span></div>
          <h3 class="member-step__title">REDEEM</h3>
          <p class="member-step__text">Redeem points for member-exclusive rewards and coupons.</p>
        </article>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Member how it works",
  "class": "member-section member-section--steps",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "member-how-it-works",
      "info": "Used by sticky navigation."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text color",
      "default": "#5c4d78"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent color",
      "default": "#9887b8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Icon emoji (if no image)",
          "default": "🎁"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon background",
          "default": "#f5e6a8"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "JOIN"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Register for free and get 100 points immediately."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Member how it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_emoji": "🎁",
            "icon_bg": "#f5e6a8",
            "title": "JOIN",
            "text": "Register for free and get 100 points immediately."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_emoji": "⏱",
            "icon_bg": "#d4edda",
            "title": "EARN",
            "text": "Earn points for every dollar spent on rorry.com."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_emoji": "🎟",
            "icon_bg": "#f8d7e8",
            "title": "REDEEM",
            "text": "Redeem points for member-exclusive rewards and coupons."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  }
}
{% endschema %}
