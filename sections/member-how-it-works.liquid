{%- style -%}
  .member-steps-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.color_background }};
  }

  .member-steps-{{ section.id }} .member-steps__wrap {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-padding, 20px);
  }

  .member-steps-{{ section.id }} .member-steps__heading {
    margin: 0 0 40px;
    text-align: center;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: {{ section.settings.color_text }};
    letter-spacing: -0.02em;
  }

  .member-steps-{{ section.id }} .member-steps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 768px) {
    .member-steps-{{ section.id }} .member-steps__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .member-steps-{{ section.id }} .member-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .member-steps-{{ section.id }} .member-step__graphic {
    width: 100%;
    max-width: {{ section.settings.graphic_max_width }}px;
    margin: 0 auto 16px;
  }

  .member-steps-{{ section.id }} .member-step__graphic img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .member-steps-{{ section.id }} .member-step__graphic-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 120px;
    border: 1px dashed rgba(92, 77, 120, 0.25);
    border-radius: 12px;
    background: rgba(152, 135, 184, 0.06);
    color: rgba(92, 77, 120, 0.45);
    font-size: 13px;
    text-align: center;
    padding: 16px;
  }

  .member-steps-{{ section.id }} .member-step__text {
    margin: 0;
    max-width: 280px;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(92, 77, 120, 0.88);
  }
{%- endstyle -%}

<div id="{{ section.settings.anchor_id | default: 'member-how-it-works' }}" class="member-steps-section member-steps-{{ section.id }}">
  <div class="member-steps__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="member-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="member-steps__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <article class="member-step" {{ block.shopify_attributes }}>
              <div class="member-step__graphic">
                {%- if block.settings.graphic != blank -%}
                  {{- block.settings.graphic
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.graphic.alt | default: block.settings.graphic_alt | escape
                  -}}
                {%- else -%}
                  <div class="member-step__graphic-placeholder">Upload icon + label image</div>
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}
                <p class="member-step__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <article class="member-step">
          <div class="member-step__graphic"><div class="member-step__graphic-placeholder">Upload icon + label image</div></div>
          <p class="member-step__text">Create your free account and instantly unlock 100 RorryCredits welcoming rewards.</p>
        </article>
        <article class="member-step">
          <div class="member-step__graphic"><div class="member-step__graphic-placeholder">Upload icon + label image</div></div>
          <p class="member-step__text">Earn RorryCredits every time you shop, sign up, celebrate your birthday, or leave a review.</p>
        </article>
        <article class="member-step">
          <div class="member-step__graphic"><div class="member-step__graphic-placeholder">Upload icon + label image</div></div>
          <p class="member-step__text">Redeem your points for cash-off discounts, free shipping, or free high-end accessories.</p>
        </article>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Member how it works",
  "class": "member-section member-section--steps",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "member-how-it-works",
      "info": "Used by sticky navigation."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Heading color",
      "default": "#5c4d78"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "graphic_max_width",
      "min": 50,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Icon + label max width",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "graphic",
          "label": "Icon + label image",
          "info": "Upload one image that includes the icon and step name (e.g. JOIN)."
        },
        {
          "type": "text",
          "id": "graphic_alt",
          "label": "Image alt text",
          "info": "Optional. Used if the image has no alt text."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Create your free account and instantly unlock 100 RorryCredits welcoming rewards."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Member how it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Create your free account and instantly unlock 100 RorryCredits welcoming rewards."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Earn RorryCredits every time you shop, sign up, celebrate your birthday, or leave a review."
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Redeem your points for cash-off discounts, free shipping, or free high-end accessories."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  }
}
{% endschema %}
