
<style>
   #shopify-section-{{section.id}} .selling_points_11{
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;

      background:{{ section.settings.background }};
position: relative;
         display: flex;
  }
  #shopify-section-{{section.id}} .selling_points_11>img{
    width:90%;
    height:auto;
    max-width:1320px;
    max-width:1200px;
    margin:0 auto;
    border-radius: 6px;
    
  }
  #shopify-section-{{section.id}} .selling_points_11>img.mobile{
    display:none;
  }
  #shopify-section-{{section.id}} .selling_points_11 .centent{
    width:90%;
    margin:0 auto;
    max-width:1320px;
    height:100%;
    display: flex;
    
    flex-direction: column;
    
    position: absolute;
    top:0;
    left:50%;
    transform: translateX(-50%);
    padding:105px 112px;
    box-sizing: border-box;
  }
  #shopify-section-{{section.id}} .selling_points_11 .centent>.title{
     margin:0;
    width: 100%;
    color:{{section.settings.title_color}};
    font-size:{{section.settings.title_size}}px;
    line-height: 1.3;
    font-weight: 700;
    /* white-space: nowrap; */
    max-width:600px;
    
    text-align: left;
  }
  #shopify-section-{{section.id}} .selling_points_11 .centent>.title *{
    margin:0;
    background: {{section.settings.title_color}};
    -webkit-background-clip: text;
    color: transparent;
  }
  #shopify-section-{{section.id}} .selling_points_11 .centent>.details{
    max-width: 611px;
    margin:40px 0;
    line-height: 1.2;
    text-align: left;
    font-size:{{section.settings.details_size}}px;
    color:{{section.settings.details_color}};
    background:{{section.settings.details_color}};
    -webkit-background-clip: text;
    color: transparent;
  }
  #shopify-section-{{section.id}} .selling_points_11 .centent>.details strong{
    color:{{section.settings.details_color_b}};
  }
   #shopify-section-{{section.id}} .selling_points_11 .centent>.details em{
     color:{{section.settings.details_color_i}};
   }

   #shopify-section-{{section.id}} .selling_points_11.max_width_img img{
     width:100%;
     max-width:none;
     border-radius: 0;
   }
  #shopify-section-{{section.id}} .selling_points_11.max_width_img .centent{
    padding:0;
   justify-content: center;
  }

  


    @media screen and (max-width: 750px) {
      #shopify-section-{{section.id}} .selling_points_11{
        margin-bottom:-1px;
      }
      #shopify-section-{{section.id}} .selling_points_11 .centent{
        padding: 0 24px;
            height: fit-content;
            top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
      }
      #shopify-section-{{section.id}} .selling_points_11>img{
    display:none;
  }
      #shopify-section-{{section.id}} .selling_points_11>img.mobile{
    display:block;
  }
         #shopify-section-{{section.id}} .selling_points_11 .centent>.title{
           font-size:{{section.settings.mobile_title_size}}px;
         }
       #shopify-section-{{section.id}} .selling_points_11 .centent>.details{
         font-size:{{section.settings.mobile_details_size}}px;
         margin:20px 0;
         max-width:175px;
       }
    }

    {% if section.settings.bk-top %}
      #shopify-section-{{section.id}} .selling_points_11.max_width_img .centent .details ,
      #shopify-section-{{section.id}} .selling_points_11.max_width_img .centent .title *{
        text-align: center !important;
      }
      #shopify-section-{{section.id}} .selling_points_11.max_width_img .centent{
          justify-content: flex-start;
    align-items: center;
    height: 85%;
    top: 50%;
    transform: translate(-50%, -50%);
      }
    {% endif %}
</style>

<div class="selling_points_11 {% if section.settings.image_box %}max_width_img{% endif %}" name="{{ section.settings.sectionname }}">
  <img loading="lazy" fetchpriority="low" src="{{ section.settings.image | img_url:'' }}" width="" height="" alt="">
  <img loading="lazy" fetchpriority="low" class="mobile" src="{{ section.settings.mobile_image | img_url:'' }}" width="" height="" alt="">
  <div class="centent">
    <div class="title">{{ section.settings.title }}</div>
    <div class="details">{{ section.settings.details }}</div>
  </div>
</div>


{% schema %}
  {
    "name": "selling points 11",
    "settings": [
      {
        "type": "checkbox",
        "id": "bk-top",
        "label": "to-top mode"
      },
      {
      "type": "text",
        "id": "sectionname",
        "label": "section name"
        },
      {
        "type": "color",
        "id": "background",
        "label": "background"
      },
      {
        "type":"image_picker",
        "id": "image",
        "label": "image"
      },
      {
        "type":"image_picker",
        "id": "mobile_image",
        "label": "mobile_image"
      },
      {
        "type": "checkbox",
        "id": "image_box",
        "default": false,
        "label": "全宽"
      },
      {
    "type": "richtext",
    "id": "title",
    "label": "title"
  },
  {
  "type": "range",
  "id": "title_size",
  "min": 0,
  "max": 100,
  "step": 1,
  "unit": "px",
  "label": "title_size",
  "default": 64
},
  {
  "type": "range",
  "id": "mobile_title_size",
  "min": 0,
  "max": 100,
  "step": 1,
  "unit": "px",
  "label": "mobile_title_size",
  "default": 24
},

  {
    "type": "color_background",
    "id": "title_color",
    "label": "title_color"
  },
    {
    "type": "inline_richtext",
    "id": "details",
    "label": "details"
  },
  {
  "type": "range",
  "id": "details_size",
  "min": 0,
  "max": 100,
  "step": 1,
  "unit": "px",
  "label": "details_size",
  "default": 64
},
  {
    "type": "range",
    "id": "mobile_details_size",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "px",
    "label": "mobile_details_size",
    "default": 24
  },

  {
    "type": "color_background",
    "id": "details_color",
    "label": "details_color"
  },
    {
    "type": "color",
    "id": "details_color_b",
    "label": "details_color_b"
  },
    {
    "type": "color",
    "id": "details_color_i",
    "label": "details_color_i"
  },
       {
          "type": "header",
          "content": "t:sections.all.padding.section_padding_heading"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 36
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 36
        },
          {
          "type": "range",
          "id": "mobile_padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "mobile 顶部填充",
          "default": 36
        },
        {
          "type": "range",
          "id": "mobile_padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "mobile 底部填充",
          "default": 36
        }
    ],
    "presets": [{"name": "selling points 11"}]
  }
{% endschema %}