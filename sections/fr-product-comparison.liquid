{% comment %}
  Section: FR Product Comparison
  One block = one comparison column (product info + specs)
{% endcomment %}

{%- liquid
  assign column_blocks = section.blocks
  assign column_count = column_blocks.size
  if column_count == 0
    assign column_count = 1
  endif

  assign max_spec_rows = 0
  for block in column_blocks
    if block.settings.specs != blank
      assign spec_lines = block.settings.specs | newline_to_br | split: '<br />'
      if spec_lines.size > max_spec_rows
        assign max_spec_rows = spec_lines.size
      endif
    endif
  endfor
-%}

<section id="fr-product-comparison-{{ section.id }}" class="fr-product-comparison">
  <div class="fr-product-comparison__inner{% unless section.settings.full_width %} page-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="fr-product-comparison__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.show_note and section.settings.note_text != blank -%}
      <label class="fr-product-comparison__note">
        <input type="checkbox" disabled{% if section.settings.note_checked %} checked{% endif %}>
        <span>{{ section.settings.note_text | escape }}</span>
      </label>
    {%- endif -%}

    <div class="fr-product-comparison__scroll">
      <div
        class="fr-product-comparison__grid"
        style="--fr-pc-columns: {{ column_count }};"
      >
        {%- for block in column_blocks -%}
          <div class="fr-product-comparison__col fr-product-comparison__col--head" {{ block.shopify_attributes }}>
            {%- if block.settings.model_label != blank -%}
              <div class="fr-product-comparison__model">{{ block.settings.model_label | escape }}</div>
            {%- endif -%}

            <div class="fr-product-comparison__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', widths: '200,400,600,800', class: 'fr-product-comparison__image', alt: block.settings.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'fr-product-comparison__placeholder' }}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="fr-product-comparison__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.price_text != blank -%}
              <p class="fr-product-comparison__price">{{ block.settings.price_text | escape }}</p>
            {%- endif -%}

            {%- liquid
              assign learn_url = block.settings.learn_more_url
              if block.settings.product != blank and learn_url == blank
                assign learn_url = block.settings.product.url
              endif
            -%}
            {%- if learn_url != blank and block.settings.learn_more_label != blank -%}
              <a class="fr-product-comparison__link" href="{{ learn_url }}">{{ block.settings.learn_more_label | escape }}</a>
            {%- endif -%}

            <div class="fr-product-comparison__head-divider" aria-hidden="true"></div>
          </div>
        {%- endfor -%}

        {%- for row_index in (0..max_spec_rows) -%}
          {%- if row_index >= max_spec_rows -%}{%- break -%}{%- endif -%}
          {%- for block in column_blocks -%}
            {%- liquid
              assign spec_label = blank
              assign spec_value = blank
              if block.settings.specs != blank
                assign spec_lines = block.settings.specs | newline_to_br | split: '<br />'
                assign spec_line = spec_lines[row_index] | strip
                if spec_line != blank
                  assign spec_parts = spec_line | split: '|'
                  assign spec_label = spec_parts[0] | strip
                  if spec_parts.size > 1
                    assign spec_value = spec_line | remove_first: spec_label | remove_first: '|' | strip
                  else
                    assign spec_value = spec_label
                    assign spec_label = blank
                  endif
                endif
              endif
            -%}
            <div class="fr-product-comparison__col fr-product-comparison__col--spec">
              {%- if spec_value != blank -%}
                <div class="fr-product-comparison__value">{{ spec_value | escape }}</div>
              {%- endif -%}
              {%- if spec_label != blank -%}
                <div class="fr-product-comparison__label">{{ spec_label | escape }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  #fr-product-comparison-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #fr-product-comparison-{{ section.id }} * {
    box-sizing: border-box;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.padding_x }}px;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 {{ section.settings.note_spacing }}px;
    font-size: {{ section.settings.note_size }}px;
    color: {{ section.settings.note_color }};
    cursor: default;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__note input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: {{ section.settings.accent_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__grid {
    display: grid;
    grid-template-columns: repeat(var(--fr-pc-columns), minmax(0, 1fr));
    min-width: min(100%, {{ column_count | times: 220 }}px);
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__col {
    padding: {{ section.settings.col_padding_x }}px;
    text-align: center;
    border-right: 1px solid {{ section.settings.border_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__col:nth-child({{ column_count }}n) {
    border-right: none;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__col--head {
    padding-bottom: {{ section.settings.head_padding_bottom }}px;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__model {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    margin: 0 auto 16px;
    padding: 8px 14px;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 4px;
    font-size: 13px;
    line-height: 1.3;
    color: {{ section.settings.text_color }};
    background: #fff;
    max-width: 100%;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__media {
    margin: 0 auto 18px;
    max-width: {{ section.settings.image_max_width }}px;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__image,
  #fr-product-comparison-{{ section.id }} .fr-product-comparison__placeholder {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__title {
    margin: 0 0 10px;
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.35;
    font-weight: 700;
    color: {{ section.settings.text_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__price {
    margin: 0 0 10px;
    font-size: {{ section.settings.price_size }}px;
    line-height: 1.4;
    color: {{ section.settings.muted_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__link {
    display: inline-block;
    margin-bottom: 18px;
    font-size: {{ section.settings.link_size }}px;
    line-height: 1.4;
    color: {{ section.settings.link_color }};
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__head-divider {
    height: 1px;
    background: {{ section.settings.border_color }};
    margin: 0 auto;
    width: 100%;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__col--spec {
    padding-top: {{ section.settings.row_padding_y }}px;
    padding-bottom: {{ section.settings.row_padding_y }}px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__value {
    font-size: {{ section.settings.value_size }}px;
    line-height: 1.45;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin-bottom: 6px;
  }

  #fr-product-comparison-{{ section.id }} .fr-product-comparison__label {
    font-size: {{ section.settings.label_size }}px;
    line-height: 1.4;
    color: {{ section.settings.muted_color }};
  }

  @media screen and (max-width: 989px) {
    #fr-product-comparison-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #fr-product-comparison-{{ section.id }} .fr-product-comparison__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #fr-product-comparison-{{ section.id }} .fr-product-comparison__grid {
      min-width: {{ column_count | times: 200 }}px;
    }

    #fr-product-comparison-{{ section.id }} .fr-product-comparison__col {
      padding-left: {{ section.settings.col_padding_x_mobile }}px;
      padding-right: {{ section.settings.col_padding_x_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "FR Product Comparison",
  "class": "shopify-section-fr-product-comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHICH MODEL IS RIGHT FOR YOU?"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note checkbox",
      "default": false
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note text",
      "default": "Compare current collection products only"
    },
    {
      "type": "checkbox",
      "id": "note_checked",
      "label": "Note checkbox checked",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width background",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "col_padding_x",
      "label": "Column padding horizontal",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "col_padding_x_mobile",
      "label": "Column padding horizontal (mobile)",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "head_padding_bottom",
      "label": "Header area bottom padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_padding_y",
      "label": "Spec row padding vertical",
      "min": 12,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Product title size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Spec value size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Spec label size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "note_size",
      "label": "Note size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "note_spacing",
      "label": "Space below note",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Comparison column",
      "limit": 4,
      "settings": [
        {
          "type": "header",
          "content": "Product info"
        },
        {
          "type": "text",
          "id": "model_label",
          "label": "Model label",
          "default": "Model A"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product title",
          "default": "Product name"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "Starting at ¥0"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Link URL"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)",
          "info": "If link URL is empty, uses this product URL"
        },
        {
          "type": "header",
          "content": "Specs"
        },
        {
          "type": "textarea",
          "id": "specs",
          "label": "Spec rows",
          "info": "One row per line. Format: Label | Value. Example: Speed Range | 1 - 7.5 mph",
          "default": "Folding Design | Vertical Fold\nSpeed Range | 1 - 7.5 mph\nControl Method | App | Knob"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FR Product Comparison",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "model_label": "Model A",
            "title": "Product A",
            "price_text": "Starting at ¥0",
            "learn_more_label": "Learn more",
            "specs": "Folding Design | Vertical Fold\nSpeed Range | 1 - 7.5 mph\nControl Method | App | Knob"
          }
        },
        {
          "type": "column",
          "settings": {
            "model_label": "Model B",
            "title": "Product B",
            "price_text": "Starting at ¥0",
            "learn_more_label": "Learn more",
            "specs": "Folding Design | Vertical Fold\nSpeed Range | 1 - 8 mph\nControl Method | App | Remote"
          }
        },
        {
          "type": "column",
          "settings": {
            "model_label": "Model C",
            "title": "Product C",
            "price_text": "Starting at ¥0",
            "learn_more_label": "Learn more",
            "specs": "Folding Design | Vertical Fold\nSpeed Range | 1 - 9 mph\nControl Method | App | Knob"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "collection"]
  }
}
{% endschema %}
