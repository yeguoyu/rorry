){.tf-coupon-left{flex-wrap:wrap;gap:8px;padding:10px}.tf-coupon-right{padding:10px}}
      .tf-coupon-title{margin-left:10px;}

       @media (max-width: 1400px) {.tf-coupon-box{width:100%;}}
       @media (max-width: 768px) {
        .tf-coupon-left{min-width:100px;}
        .tf-item{padding:8px;}
        .tf-item .icon-custom{width:14px;height:14px;}
        .tf-item .text-base{font-size:14px;}
        .tf-right-icon{width:14px;height:14px;}
