<style>
    .product__info klarna-placement::part(osm-container),
  .product__info klarna-placement .container {
    border-color: transparent !important;
    padding-left: 0px !important;
  }
 #product-klarna-badge::part(osm-badge) {
  width: 48px !important;
  height: auto !important;
}

      .features-show .metafield-rich_text_field ul{
      margin-top: 0 !important;
    }
    product-info.product__info .rte {
          margin: 0 !important;
      }
      .tf-mf-trigger {
      margin-bottom: 0 !important;
      }
      {% comment %} 固定粘性加购按钮 {% endcomment %}
        .sticky-bar-custom-v2 {
        opacity: 1 !important;
        visibility: visible !important;
        transform: translateY(0) !important;
        transition: none !important; /* 可选，取消动画 */
      }

       #shopify-section-{{ section.id }} {
          --section-padding-top: {{ section.settings.padding_top }}px;
          --section-padding-bottom: {{ section.settings.padding_bottom }}px;
        }
        .alert--success{
         color:#4D7C0F !important;
         background-color:#F5F9EF !important;
        }
       .product-form__buttons .flex-wrap {
          flex-wrap: nowrap;
      }

      {%- if product.template_suffix == 'new-t1-5000-1' -%}
      #shopify-section-{{ section.id }} .product-form__buttons .flex-wrap {
        flex-wrap: wrap;
      }
      #shopify-section-{{ section.id }} .product-form .product-logo-upload {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        width: 100%;
        margin: 0 0 4px;
      }
      #shopify-section-{{ section.id }} .product-form .product-logo-upload[hidden] {
        display: none;
      }
      #shopify-section-{{ section.id }} .product-form .product-logo-upload label {
        font-size: 14px;
        font-weight: 500;
        line-height: 1.4;
        margin: 0;
      }
      #shopify-section-{{ section.id }} .product-form .product-logo-upload input[type="file"] {
        flex: 1 1 180px;
        min-width: 0;
        max-width: 100%;
        font-size: 14px;
      }
      #shopify-section-{{ section.id }} .product-form .product-logo-upload input[type="file"]::file-selector-button {
        appearance: none;
        border: 0;
        background: #e8e4f2;
        color: #171717;
        font: inherit;
        font-weight: 500;
        padding: 10px 18px;
        margin-inline-end: 12px;
        border-radius: 999px;
        cursor: pointer;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: stretch;
        gap: 12px;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons > :has(input[type="file"]),
      #shopify-section-{{ section.id }} .product-form .buy-buttons > input[type="file"] {
        flex: 1 0 100%;
        width: 100%;
        max-width: 100%;
        order: -2;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons > table,
      #shopify-section-{{ section.id }} .product-form .buy-buttons > :has(> table) {
        flex: 1 0 100%;
        width: 100%;
        order: -1;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons > quantity-input,
      #shopify-section-{{ section.id }} .product-form .buy-buttons > .quantity {
        flex: 0 0 36%;
        width: 36%;
        max-width: 11rem;
        min-width: 7.25rem;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons > .product-form__submit {
        flex: 1 1 0;
        min-width: 0;
      }
      #shopify-section-{{ section.id }} .product-form .buy-buttons > .shopify-payment-button,
      #shopify-section-{{ section.id }} .product-form .buy-buttons shopify-accelerated-checkout {
        flex: 1 0 100%;
        width: 100%;
        order: 5;
      }
      #shopify-section-{{ section.id }} .product-form :is(table, volume-pricing, .volume-pricing) {
        width: 100%;
        max-width: 100%;
      }
      @media screen and (max-width: 767px) {
        #shopify-section-{{ section.id }} .product-form .product-logo-upload {
          flex-direction: column;
          align-items: stretch;
        }
        #shopify-section-{{ section.id }} .product-form .product-logo-upload input[type="file"] {
          width: 100%;
        }
        #shopify-section-{{ section.id }} .product-form .product-logo-upload input[type="file"]::file-selector-button {
          width: 100%;
          margin-inline-end: 0;
          margin-bottom: 8px;
          padding: 12px 18px;
          border-radius: 12px;
        }
        #shopify-section-{{ section.id }} .product-form .buy-buttons > quantity-input,
        #shopify-section-{{ section.id }} .product-form .buy-buttons > .quantity {
          flex: 0 0 38%;
          width: 38%;
          max-width: none;
        }
      }
      {%- endif -%}
        @media screen and (min-width: 1024px) {
          #shopify-section-{{ section.id }} {
            {%- assign media_ratio = section.settings.media_size | divided_by: 50.0 -%}
            --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
          }
        }

        {%- assign first_media = product.selected_or_first_available_variant.featured_media | default: product.media.first -%}
        @media screen and (max-width: 767px) {
          #shopify-section-{{ section.id }} {
            --aspect-ratio: {{ first_media.aspect_ratio }};
          }
        }

        @media screen and (min-width: 768px) {
          #shopify-section-{{ section.id }} {
            --aspect-ratio: {{ first_media.aspect_ratio }};
          }
        }
      .tf-box { overflow: hidden; margin-bottom: 20px; }
        .tf-list { list-style: none; padding: 0; margin: 0; }
        .tf-item { display: flex; justify-content: space-between; align-items: center; padding: 16px; border-bottom: 1px solid #e5e5e5; cursor: pointer; transition: background 0.2s ease; }
        .tf-item:last-child { border-bottom: none; }
        .tf-item:hover { background: #f9f9f9; }
        .tf-item-static { cursor: default; flex-direction: column; align-items: flex-start; gap: 12px; }
        .tf-item-static:hover { background: transparent; }
        .tf-payment-icons { display: flex; flex-wrap: wrap; gap: 6px; }
        .tf-payment-icons svg { width: 38px; height: 24px; }
        .tf-delivery-img { max-height: 24px; width: auto; object-fit: contain; }
      .tf-modal { border: none; border-radius: 8px; padding: 0; width: 90%; max-width: 480px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); margin: auto; }
      .tf-modal::backdrop { background: rgba(0, 0, 0, 0.5); }
      .tf-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px;margin-bottom:20px; border-bottom: 1px solid #e5e5e5; position: sticky; top: 0; background: #fff; z-index: 2; }
      .tf-modal-title { font-size: 1.125rem; font-weight: 600; margin: 0; }
      .tf-modal-close { cursor: pointer; background: transparent; border: 1px solid #ddd; border-radius: 4px; display: flex; padding: 4px; transition: background 0.2s; }
      .tf-modal-close:hover { background: #f0f0f0; }
      .tf-modal-body { padding: 0 20px 20px 20px; max-height: 65vh; overflow-y: auto; }
      .tf-accordion { border-bottom: 1px solid #e5e5e5; padding: 16px 0; }
      .tf-accordion:last-child { border-bottom: none; }
      .tf-accordion-summary { display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none; }
      .tf-accordion-summary::-webkit-details-marker { display: none; }
      .tf-accordion[open] .tf-chevron { transform: rotate(180deg); }
      .tf-accordion-content { margin-top: 12px; color: #555; font-size: 0.9rem; line-height: 1.6; }
      .tf-mf-trigger { margin:20px 0;display: block; cursor: pointer; padding: 20px 0; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5;  transition: opacity 0.2s; }
      .tf-mf-trigger:hover { opacity: 0.7; }
      .tf-mf-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0px; }
      .tf-mf-title { font-size: 1.125rem; font-weight: 600; margin: 0; }
      .tf-mf-summary p, .tf-mf-summary img, .tf-mf-summary ul, .tf-mf-summary ol, .tf-mf-summary blockquote, .tf-mf-summary h1, .tf-mf-summary h2, .tf-mf-summary h3, .tf-mf-summary h4, .tf-mf-summary h6 { display: none !important; }
      .tf-mf-summary h5 strong{font-weight: 400 !important;}
      .tf-mf-summary h5 { display: list-item !important; list-style-type: disc !important; margin: 0 0 8px 24px !important; font-size: 1rem !important; font-weight: 400 !important; line-height: 1.4 !important; color: #333 !important; }
      .tf-mf-modal { border: none; border-radius: 8px; padding: 0; width: 90%; max-width: 550px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); margin: auto; }
      .tf-mf-modal::backdrop { background: rgba(0, 0, 0, 0.5); }
      .tf-mf-modal-body { padding: 20px;padding-top:0px; max-height: 70vh; overflow-y: auto; }
      .tf-mf-modal-body h5 { font-size: 16px !important; font-weight: 600; margin: 20px 0 6px 0; color: #111; }
      .tf-mf-modal-body p { font-size: 0.95rem; line-height: 1.5; color: #555; margin: 0 0 10px 0; }
      .tf-mf-modal-body > *:first-child { margin-top: 0; }
      .product__metafield-popup{margin-top:0px;}
        {% comment %} .tf-coupon-box { ... 旧版注释样式 ... } {% endcomment %}
