</style>

{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id | append: '-' | append: product.id
  assign media_count = product.media.size
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign icon_list_block = section.blocks | where: 'type', 'icon_list' | first
-%}

{%- if first_3d_model -%}
  {{ 'model-viewer.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{%- if product.quantity_price_breaks_configured? -%}
  {{ 'volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'volume-pricing.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if icon_list_block -%}
  {%- capture icon_list_render -%}
    {%- if settings.product_icon_list_metafield != blank -%}
      {%- liquid
        assign metafield_parts = settings.product_icon_list_metafield | split: '.'
        assign metafield_namespace = metafield_parts | first
        assign metafield_key = metafield_parts | last
        assign metafield = product.metafields[metafield_namespace][metafield_key]
      -%}
      {%- if metafield.value != blank and metafield.list? -%}
        <div class="product__highlights{% if icon_list_block.settings.heading != blank %} with-heading flex flex-col gap-5 relative{% endif %}{% if icon_list_block.settings.show_below_media %} below-media{% endif %}" {{ icon_list_block.shopify_attributes }}>
          {%- if icon_list_block.settings.heading != blank -%}
            <p class="font-medium leading-tight md:text-lg">{{ icon_list_block.settings.heading | escape }}</p>
          {%- endif -%}
          <scroll-shadow class="product-card__spec block overflow-hidden">
            <div class="product-card__icons flex flex-nowrap{% unless icon_list_block.settings.enable_carousel %} lg:flex-wrap{% endunless %}" is="icons-carousel" tabindex="0">
              {%- for item in metafield.value -%}
                <div class="product-card__icon shrink-0">
                  <div class="flex flex-col items-center md:flex-row md:items-start gap-2">
                    {%- if item.icon != blank -%}
                      <figure class="shrink-0 media media--transparent relative inline-block">
                        {{- item.icon | image_url: width: item.icon.width | image_tag: loading: 'lazy', sizes: '32px', widths: '80,96,160,192', class: 'w-full h-full', is: 'lazy-image' -}}
                      </figure>
                    {%- endif -%}
                    <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left text-sm font-medium leading-none">
                      {{- item.title -}}
                      {%- if item.description != blank -%}
                        <p class="text-opacity font-normal text-xs leading-tight">{{ item.description }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
            <template>
              <slot></slot>
              <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
                <span class="l"></span>
                <span class="r"></span>
              </s>
              <style>
                :host{display:inline-block;position:relative}:host([hidden]){display:none}
                s{position:absolute;inset:0;pointer-events:none;}
                s span{position:absolute;inset-block:0;width:clamp(var(--sp-12),4.73vw,var(--sp-23));opacity:0;transition:opacity var(--animation-short);}
                s .l{inset-inline-start:0;opacity:var(--l);background:linear-gradient(90deg,rgb(var(--color-background)) 0%,transparent 100%);}
                s .r{inset-inline-end:0;opacity:var(--r);background:linear-gradient(270deg,rgb(var(--color-background)) 0%,transparent 100%);}
                s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
              </style>
            </template>
          </scroll-shadow>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}
{%- endif -%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if media_count > 0 %}{% if section.settings.full_width %} page-width--full{% endif %}{% else %} page-width--narrow{% endif %} relative">
    <div class="featured-product product product--{{ section.settings.gallery_layout }}{% if media_count == 0 %} no-media{% endif %} flex flex-col items-start lg:grid gap-5 w-full relative">
      {%- if media_count > 0 -%}
        <div class="product__gallery-container{% if section.settings.enable_sticky_info %} lg:sticky{% endif %} flex flex-col gap-0 md:gap-8 relative w-full">
          {%- render 'product-media-gallery',
            product: product,
            product_id: product.id,
            section_id: section.id,
            gallery_layout: section.settings.gallery_layout,
            thumbnail_position: section.settings.thumbnail_position,
            image_ratio: section.settings.image_ratio,
            image_ratio_mobile: section.settings.image_ratio_mobile,
            image_zoom: section.settings.image_zoom,
            image_fill: settings.product_image_fill,
            mobile_layout: section.settings.mobile_layout,
            mobile_thumbnail: section.settings.mobile_thumbnail,
            hide_variants: section.settings.hide_variants,
            enable_video_autoplay: section.settings.enable_video_autoplay,
            enable_video_looping: section.settings.enable_video_looping,
            first_3d_model: first_3d_model,
            product_form_id: product_form_id
          -%}

          {%- liquid
            if icon_list_block and icon_list_block.settings.show_below_media
              echo icon_list_render
            endif
          -%}
        </div>
      {%- endif -%}

      <product-info
        id="ProductInfo-{{ section.id }}-{{ product.id }}"
        class="product__info{% if section.settings.enable_sticky_info %} lg:sticky{% endif %} block w-full"
        data-animate="fade-up"
        data-immediate
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        data-update-url="true"
        form="{{ product_form_id }}"
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'coupon_code' -%}
              <div class="product__coupon w-full" {{ block.shopify_attributes }}>
                <div class="tf-coupon-box">
                  <div class="tf-coupon-left">
                    <svg
                      class="tf-coupon-icon"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    </svg>
                    <div class="tf-coupon-save-text">{{ block.settings.left_top_text }}</div>
                    <div class="tf-coupon-amount">{{ block.settings.left_bottom_text }}</div>
                    <div class="tf-coupon-title rte">With Code: {{ block.settings.main_title }}</div>
                  </div>
                  <div class="tf-coupon-right">
                    <button
                      type="button"
                      class="tf-coupon-copy-btn"
                      onclick="tfCopyCode(this, '{{ block.settings.discount_code }}')"
                    >
                      {{ block.settings.copy_text }}
                    </button>
                  </div>
                </div>

                <script>
                  window.tfCopyCode =
                    window.tfCopyCode ||
                    function (btn, code) {
                      navigator.clipboard.writeText(code).then(() => {
                        const originalText = btn.innerText;
                        btn.innerText = 'Copied!';
                        setTimeout(() => {
                          btn.innerText = originalText;
                        }, 2000);
                      });
                    };
                </script>
              </div>
            {%- when 'coupon_cards_row' -%}
              {%- render 'discount-coupon-cards', block: block, section: section -%}
            {%- when 'metafield_popup' -%}
              {%- liquid
                assign mf_parts = block.settings.metafield_key | split: '.'
                assign mf_namespace = mf_parts | first
                assign mf_key = mf_parts | last
                assign mf_value = product.metafields[mf_namespace][mf_key]
              -%}

              {%- if mf_value != blank -%}
                <div class="product__metafield-popup w-full" {{ block.shopify_attributes }}>
                  <div
                    class="tf-mf-trigger"
                    onclick="document.getElementById('MfModal-{{ section.id }}-{{ block.id }}').showModal()"
                  >
                    <div class="tf-mf-header-row">
                      <div class="tf-mf-title">{{ block.settings.title }}</div>
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </div>
                    <div class="tf-mf-summary">
                      {{ mf_value | metafield_tag }}
                    </div>
                  </div>

                  <dialog id="MfModal-{{ section.id }}-{{ block.id }}" class="tf-mf-modal tf-modal">
                    <div class="tf-modal-header">
                      <h3 class="tf-modal-title">{{ block.settings.title }}</h3>
                      <button
                        type="button"
                        class="tf-modal-close"
                        onclick="document.getElementById('MfModal-{{ section.id }}-{{ block.id }}').close()"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          stroke="currentColor"
                          stroke-width="2"
                          fill="none"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </div>
                    <div class="tf-mf-modal-body rte">
                      {{ mf_value | metafield_tag }}
                    </div>
                  </dialog>
                </div>
              {%- endif -%}
            {%- when 'trust_features' -%}
              <div class="product__trust-features w-full" {{ block.shopify_attributes }}>
                <div class="tf-box">
                  <ul class="tf-list">
                    {%- for i in (1..4) -%}
                      {%- assign title_key = 'title_' | append: i -%}
                      {%- assign desc_key = 'desc_' | append: i -%}
                      {%- assign icon_key = 'icon_' | append: i -%}
                      {%- assign title = block.settings[title_key] -%}
                      {%- assign desc = block.settings[desc_key] -%}
                      {%- assign icon = block.settings[icon_key] -%}

                      {%- if title != blank -%}
                        <li class="tf-item" onclick="openTrustModal('{{ section.id }}-{{ block.id }}', {{ i }})">
                          <div class="flex items-center gap-3">
                            {%- if icon != 'none' -%}
                              <span class="flex items-center justify-center shrink-0">
                                {%- render 'icon-guarantee',
                                  icon: icon,
                                  size: 'custom',
                                  class: 'inline-block stroke-1',
                                  width: 22
                                -%}
                              </span>
                            {%- endif -%}
                            <span class="text-base font-medium">{{ title }}</span>
                          </div>
                          <div class="tf-right-icon">
                            <svg
                              viewBox="0 0 24 24"
                              width="18"
                              height="18"
                              stroke="#aaa"
                              stroke-width="2"
                              fill="none"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if block.settings.show_payment -%}
                      <li class="tf-item tf-item-static">
                        <div class="font-medium text-base">Payment Methods</div>
                        <div class="tf-payment-icons">
                          {%- for type in shop.enabled_payment_types -%}
                            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                          {%- endfor -%}
                        </div>
                      </li>
                    {%- endif -%}

                    {%- if block.settings.delivery_img != blank -%}
                      <li class="tf-item tf-item-static">
                        <div class="font-medium text-base">Delivery Method</div>
                        <img
                          src="{{ block.settings.delivery_img | image_url: width: 300 }}"
                          alt="Delivery"
                          class="tf-delivery-img"
                        >
                      </li>
                    {%- endif -%}
                  </ul>
                </div>

                <dialog id="TrustModal-{{ section.id }}-{{ block.id }}" class="tf-modal">
                  <div class="tf-modal-header">
                    <h3 class="tf-modal-title">{{ block.settings.modal_title }}</h3>
                    <button
                      type="button"
                      class="tf-modal-close"
                      onclick="closeTrustModal('{{ section.id }}-{{ block.id }}')"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                  <div class="tf-modal-body">
                    {%- for i in (1..4) -%}
                      {%- assign title_key = 'title_' | append: i -%}
                      {%- assign desc_key = 'desc_' | append: i -%}
                      {%- assign icon_key = 'icon_' | append: i -%}
                      {%- assign title = block.settings[title_key] -%}
                      {%- assign desc = block.settings[desc_key] -%}
                      {%- assign icon = block.settings[icon_key] -%}

                      {%- if title != blank and desc != blank -%}
                        <details class="tf-accordion" id="tf-accordion-{{ section.id }}-{{ block.id }}-{{ i }}">
                          <summary class="tf-accordion-summary">
                            <div class="flex items-center gap-3">
                              {%- if icon != 'none' -%}
                                <span class="flex items-center justify-center shrink-0">
                                  {%- render 'icon-guarantee',
                                    icon: icon,
                                    size: 'custom',
                                    class: 'inline-block stroke-1',
                                    width: 22
                                  -%}
                                </span>
                              {%- endif -%}
                              <span class="font-medium">{{ title }}</span>
                            </div>
                            <svg
                              class="tf-chevron shrink-0 transition-transform"
                              viewBox="0 0 24 24"
                              width="16"
                              height="16"
                              stroke="currentColor"
                              stroke-width="2"
                              fill="none"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                          </summary>
                          <div class="tf-accordion-content rte">
                            {{ desc }}
                          </div>
                        </details>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </dialog>
                <script>
                  function openTrustModal(id, index) {
                    const modal = document.getElementById('TrustModal-' + id);
                    if (modal) {
                      modal.showModal();
                      const allDetails = modal.querySelectorAll('details');
                      allDetails.forEach((el) => (el.open = false));
                      const target = document.getElementById('tf-accordion-' + id + '-' + index);
                      if (target) target.open = true;
                    }
                  }
                  function closeTrustModal(id) {
                    const modal = document.getElementById('TrustModal-' + id);
                    if (modal) modal.close();
                  }
                </script>
              </div>

            {%- when '@app' -%}
              {%- render block -%}

            {%- when 'breadcrumb' -%}
              {%- render 'product-breadcrumb', product: product, block: block -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.text != product.vendor -%}
                  {%- liquid
                    assign prev_index = forloop.index0 | minus: 1
                    assign prev_block = section.blocks[prev_index]
                    assign next_index = forloop.index0 | plus: 1
                    assign next_block = section.blocks[next_index]

                    if prev_block.type == 'sticky_buy_button'
                      assign prev_index = prev_index | minus: 1
                      assign prev_block = section.blocks[prev_index]
                    endif

                    if next_block.type == 'sticky_buy_button'
                      assign next_index = next_index | plus: 1
                      assign next_block = section.blocks[next_index]
                    endif

                    if prev_block.type != 'text'
                      assign block_index = 1
                    else
                      assign block_index = block_index | plus: 1
                    endif

                    assign modulo = block_index | modulo: 2
                  -%}
                  <div
                    class="product__text{% if modulo == 0 %} even{% endif %}{% if prev_block.type != 'text' %} first{% endif %}{% if next_block.type != 'text' %} last{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="product__text-inner flex items-center gap-2d5">
                      {%- if block.settings.icon_image != blank -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            assign icon_width = block.settings.icon_image.width
                          else
                            assign icon_width = block.settings.icon_width
                          endif
                        -%}
                        <figure class="media media--transparent relative inline-block">
                          {%- capture sizes -%}{{ icon_width }}px{%- endcapture -%}
                          {%- capture widths -%}{{ icon_width }}, {{ icon_width | times: 2 | at_most: block.settings.icon_image.width }}{%- endcapture -%}
                          {%- assign image_alt = block.settings.icon_image.alt
                            | default: block.settings.accessibility_info
                            | escape
                          -%}
                          {%- assign image_alt = image_alt | default: block.settings.text | escape -%}
                          {{-
                            block.settings.icon_image
                            | image_url: width: block.settings.icon_image.width
                            | image_tag:
                              loading: 'lazy',
                              sizes: sizes,
                              widths: widths,
                              alt: image_alt,
                              class: 'image-fit'
                          -}}
                        </figure>
                      {%- elsif block.settings.icon != 'none' -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            render 'icon-guarantee', icon: block.settings.icon, size: 'lg', class: 'inline-block stroke-1'
                          else
                            render 'icon-guarantee', icon: block.settings.icon, size: 'custom', class: 'inline-block stroke-1', width: block.settings.icon_width
                          endif
                        -%}
                      {%- endif -%}
                      <p class="rte {{ block.settings.text_size }} leading-tight">{{ block.settings.text }}</p>
                    </div>
                  </div>
                {%- else -%}
                  <p class="product__vendor {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                    {{- product.vendor | link_to_vendor: class: 'reversed-link' -}}
                  </p>
                {%- endif -%}
              {%- endif -%}

            {%- when 'sku' -%}
              <p class="product__sku" id="Sku-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                {{- product.selected_or_first_available_variant.sku -}}
              </p>

              {% comment %}
                {%- when 'badges' -%}
                <div class="product__badges" id="Badges-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                  {%- render 'product-badges', product: product, use_variant: true, show_sold_out: block.settings.show_sold_out, show_save_amount: block.settings.show_save_amount, save_type: block.settings.save_type, class: 'flex flex-wrap gap-3' -%}
                </div>
              {% endcomment %}

            {%- when 'description' -%}
              <div class="product__text rte {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                {{- product.description -}}
              </div>

            {%- when 'title' -%}
              {%- liquid
                assign price_block = section.blocks | where: 'type', 'price' | first
                assign rating_block = section.blocks | where: 'type', 'rating' | first
              -%}
              <div
                class="product__title grid gap-3{% if price_block == blank and block.settings.show_price %} with-price{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} with-price--on-sale{% endif %}{% endif %}"
                {{ block.shopify_attributes }}
              >
                <h1 class="heading leading-none {{ block.settings.title_size }} mobile:{{ block.settings.title_size_mobile }} col-span-full">
                  <split-words class="split-words js-invisible block" data-animate="fade-up">
                    {{- product.title -}}
                  </split-words>
                </h1>

                {%- if price_block == blank and block.settings.show_price -%}
                  <div id="Price-{{ section.id }}-{{ product.id }}" class="product__price">
                    {%- render 'product-price',
                      product: product,
                      use_variant: true,
                      class: 'flex flex-wrap items-baseline gap-2 lg:flex-col xl:items-end lg:gap-1d5'
                    -%}

                    {%- if product.quantity_price_breaks_configured? -%}
                      <div
                        class="text-opacity text-sm font-medium leading-tight"
                        id="VolumeNote-{{ section.id }}-{{ product.id }}"
                      >
                        {{- 'products.volume_pricing.note' | t -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- liquid
                  if rating_block == blank and block.settings.show_rating
                    render 'product-rating', product: product
                  endif
                -%}
              </div>

              {%- if price_block == blank and block.settings.show_price -%}
                {%- assign product_form_installment_id = 'ProductFormInstallment-'
                  | append: section.id
                  | append: '-'
                  | append: product.id
                -%}
                {%- form 'product',
                  product,
                  id: product_form_installment_id,
                  class: 'installment text-sm leading-tight'
                -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price grid gap-3" {{ block.shopify_attributes }}>
                <div class="no-js-hidden" id="Price-{{ section.id }}-{{ product.id }}">
                  {%- render 'product-price',
                    product: product,
                    use_variant: true,
                    class: 'flex flex-wrap items-baseline gap-2 lg:gap-1d5'
                  -%}

                  {%- if product.quantity_price_breaks_configured? -%}
                    <div
                      class="text-opacity text-sm font-medium leading-tight"
                      id="VolumeNote-{{ section.id }}-{{ product.id }}"
                    >
                      {{- 'products.volume_pricing.note' | t -}}
                    </div>
                  {%- endif -%}
                </div>

                {%- assign product_form_installment_id = 'ProductFormInstallment-'
                  | append: section.id
                  | append: '-'
                  | append: product.id
                -%}
                {%- form 'product',
                  product,
                  id: product_form_installment_id,
                  class: 'installment text-sm leading-tight'
                -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}

                {%- if block.settings.show_taxes_notice -%}
                  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax rte text-sm">
                      {%- liquid
                        if cart.taxes_included
                          echo 'products.product.include_taxes' | t
                        endif
                        if shop.shipping_policy.body != blank
                          echo 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url
                        endif
                      -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'quantity_selector' -%}
              {%- if product.available -%}
                <div id="QuantityForm-{{ section.id }}-{{ product.id }}" class="field" {{ block.shopify_attributes }}>
                  {%- assign cart_qty = cart
                    | item_count_for_variant: product.selected_or_first_available_variant.id
                  -%}
                  <label
                    for="Quantity-{{ section.id }}-{{ product.id }}"
                    class="quantity__label label"
                    is="quantity-label"
                  >
                    {{ 'products.quantity.label' | t }}
                    <span
                      id="QuantityRulesCart-{{ section.id }}-{{ product.id }}"
                      class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %} relative"
                    >
                      <span class="quantity-cart font-medium"
                        >({{ 'products.quantity.in_cart_html' | t: quantity: cart_qty }})</span
                      >
                    </span>
                  </label>
                  <div class="flex items-center gap-4">
                    <quantity-input
                      class="quantity inline-flex relative"
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ product.id }}"
                    >
                      <button
                        type="button"
                        name="minus"
                        class="quantity__button"
                        aria-label="{{ 'products.quantity.decrease' | t: product: product.title | escape }}"
                      >
                        {%- render 'icon', icon: 'chevron-left', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                      <input
                        id="Quantity-{{ section.id }}-{{ product.id }}"
                        class="quantity__input text-sm sm:text-base font-medium text-center"
                        type="number"
                        name="quantity"
                        inputmode="numeric"
                        autocomplete="off"
                        data-quantity-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button
                        type="button"
                        name="plus"
                        class="quantity__button"
                        aria-label="{{ 'products.quantity.increase' | t: product: product.title | escape }}"
                      >
                        {%- render 'icon', icon: 'chevron-right', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                    </quantity-input>

                    {%- if product.quantity_price_breaks_configured? -%}
                      {%- liquid
                        assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                        if cart_qty > 0
                          assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                        endif
                        assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                      -%}
                      <price-per-item
                        id="PricePerItem-{{ section.id }}-{{ product.id }}"
                        class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                        data-section-id="{{ section.id }}"
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- if variant_price_compare -%}
                          <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                          <span class="price__sale inline-flex items-center h-auto relative">
                            {%- liquid
                              if settings.currency_code_enabled
                                echo variant_price_compare | money_with_currency
                              else
                                echo variant_price_compare | money
                              endif
                            -%}
                          </span>
                          <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                        {%- endif -%}

                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                            </span>
                          {%- else -%}
                            {%- for price_break in volume_pricing_array -%}
                              {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                {%- liquid
                                  if settings.currency_code_enabled
                                    assign price_break_price = price_break.price | money_with_currency
                                  else
                                    assign price_break_price = price_break.price | money
                                  endif
                                -%}
                                <span class="price-per-item--current price__regular whitespace-nowrap">
                                  {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                                </span>
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- else -%}
                          <span class="price-per-item--current price__regular whitespace-nowrap">
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                          </span>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>

                  {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1
                    or product.selected_or_first_available_variant.quantity_rule.min > 1
                    or product.selected_or_first_available_variant.quantity_rule.max != null
                  -%}
                    <div
                      class="quantity__rules text-sm font-medium leading-tight"
                      id="QuantityRules-{{ section.id }}-{{ product.id }}"
                    >
                      {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                        <span class="divider">
                          {{-
                            'products.quantity.multiples_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                        <span class="divider">
                          {{-
                            'products.quantity.minimum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                          -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                        <span class="divider">
                          {{-
                            'products.quantity.maximum_of'
                            | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                          -}}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'volume_pricing' -%}
              {%- if product.quantity_price_breaks_configured? -%}
                <volume-pricing class="volume-pricing grid gap-6" id="Volume-{{ section.id }}-{{ product.id }}">
                  {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                    <span class="caption-large font-medium">{{ 'products.volume_pricing.title' | t }}</span>
                    <ul class="list-unstyled">
                      <li class="text-sm flex gap-2d5 justify-between">
                        <span class="font-medium">
                          {{- product.selected_or_first_available_variant.quantity_rule.min }}+</span
                        >
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: variant_price }}">
                          {{- 'sections.quick_order_list.each' | t: money: variant_price -}}
                        </span>
                      </li>
                      {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign price_break_price = price_break.price | money_with_currency
                          else
                            assign price_break_price = price_break.price | money
                          endif
                        -%}
                        <li class="text-sm flex gap-2d5 justify-between{% if forloop.index >= 3 %} show-more-item hidden{% endif %}">
                          <span class="font-medium">
                            {{- price_break.minimum_quantity -}}
                            <span aria-hidden="true">+</span>
                          </span>
                          <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: price_break_price }}">
                            {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                          </span>
                        </li>
                      {%- endfor -%}
                    </ul>
                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                      <show-more-button>
                        <button
                          class="button-show-more link text-sm leading-tight"
                          id="ShowMore-{{ section.id }}-{{ product.id }}"
                          type="button"
                        >
                          <span class="label-show-more">{{ 'products.general.show_more' | t }}</span>
                        </button>
                      </show-more-button>
                    {%- endif -%}
                  {%- endif -%}
                </volume-pricing>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- render 'product-variant-picker',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id,
                image_ratio: section.settings.image_ratio,
                image_ratio_mobile: section.settings.image_ratio_mobile,
                image_fill: settings.product_image_fill
              -%}

            {%- when 'product_variations' -%}
              {%- render 'product-variants',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id,
                image_ratio: section.settings.image_ratio,
                image_ratio_mobile: section.settings.image_ratio_mobile,
                image_fill: settings.product_image_fill
              -%}

            {%- when 'buy_buttons' -%}
              {%- render 'buy-buttons',
                block: block,
                section: section,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id
              -%}

            {%- when 'pickup_availability' -%}
              {%- render 'pickup-availability',
                block: block,
                section: section,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id
              -%}

            {%- when 'inventory' -%}
              {%- render 'product-inventory',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id
              -%}

            {%- when 'share' -%}
              <div class="flex justify-between items-center" {{ block.shopify_attributes }}>
                {%- liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  assign share_image = product.selected_variant.featured_image | default: product.featured_image
                -%}
                {%- render 'social-sharing',
                  section_id: section.id,
                  share_id: product.id,
                  share_label: block.settings.share_label,
                  share_title: product.title,
                  share_link: share_url,
                  share_image: share_image
                -%}

                {%- if block.settings.show_help_desk -%}
                  <div class="flex items-center gap-2">
                    {%- render 'icon', icon: 'question' -%}
                    {%- if block.settings.help_type == 'drawer' -%}
                      <button
                        type="button"
                        class="link text-sm leading-tight cursor-pointer"
                        aria-controls="HelpDrawer"
                      >
                        {{- block.settings.help_label | escape -}}
                      </button>
                    {%- else -%}
                      <a
                        class="link text-sm leading-tight cursor-pointer"
                        {% if block.settings.help_page != blank %}
                          href="{{ block.settings.help_page.url }}"
                          {%- if block.settings.help_page_external %} target="_blank" rel="noopener"{% endif -%}
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        {{- block.settings.help_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'help_desk' -%}
              <div class="flex items-center gap-2" {{ block.shopify_attributes }}>
                {%- render 'icon', icon: 'question' -%}
                {%- if block.settings.help_type == 'drawer' -%}
                  <button type="button" class="link text-sm leading-tight cursor-pointer" aria-controls="HelpDrawer">
                    {{- block.settings.help_label | escape -}}
                  </button>
                {%- else -%}
                  <a
                    class="link text-sm leading-tight cursor-pointer"
                    {% if block.settings.help_page != blank %}
                      href="{{ block.settings.help_page.url }}"
                      {%- if block.settings.help_page_external %} target="_blank" rel="noopener"{% endif -%}
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                  >
                    {{- block.settings.help_label | escape -}}
                  </a>
                {%- endif -%}
              </div>

            {%- when 'rating' -%}
              {%- render 'product-rating', product: product, block: block -%}

            {%- when 'complementary' -%}
              {%- render 'product-complementary',
                section_id: section.id,
                product_id: product.id,
                image_ratio: settings.product_image_ratio,
                image_fill: settings.product_image_fill,
                limit: block.settings.product_limit,
                heading: block.settings.heading,
                show_vendor: block.settings.show_vendor,
                show_price: block.settings.show_price
              -%}

            {%- when 'liquid' -%}
              {%- if block.settings.liquid != blank -%}
                <div class="rte" {{ block.shopify_attributes }}>
                  {{- block.settings.liquid -}}
                </div>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              <details
                class="product__accordion details {{ block.settings.style }}"
                is="accordion-details"
                {% if block.settings.opened %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                  <div class="flex items-center gap-2d5">
                    {%- render 'icon-accordion', icon: block.settings.icon -%}
                    <span class="text-sm-base font-medium leading-none">
                      {{- block.settings.heading | default: block.settings.page.title | escape -}}
                    </span>
                  </div>
                  {%- render 'icon', icon: 'plus-2', size: 'xs', class: 'shrink-0' -%}
                </summary>
                <div class="details__content rte {{ block.settings.text_size }} text-opacity">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                  {{ block.settings.liquid }}
                </div>
              </details>

            {%- when 'countdown' -%}
              {%- if product.metafields.theme.countdown.value != blank -%}
                {%- liquid
                  assign now_time = 'now' | date: '%s' | times: 1
                  assign countdown_time = product.metafields.theme.countdown.value | date: '%s' | times: 1
                -%}
                {%- if countdown_time > now_time -%}
                  <div
                    class="product-countdown grid sm:flex items-center justify-between gap-2d5"
                    id="shopify-block-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="flex items-center gap-3">
                      {%- render 'icon', icon: 'countdown', size: 'xl', class: 'shrink-0 block lg:hidden xl:block' -%}
                      <div class="grid">
                        {%- if block.settings.heading != blank -%}
                          <p class="heading text-base lg:text-lg xl:text-xl leading-tight">
                            {{ block.settings.heading | escape }}
                          </p>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="uppercase text-3xs font-medium leading-none tracking-widest">
                            {{ block.settings.subheading | escape }}
                          </p>
                        {%- endif -%}
                      </div>
                    </div>
                    <countdown-timer
                      class="countdown__timer flex text-center"
                      data-expires="{{ product.metafields.theme.countdown.value | date: '%FT%T%:z' | escape }}"
                    >
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.days' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.hours' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.minutes' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p>
                        <span>{{ 'general.date.seconds' | t }}</span>
                      </div>
                    </countdown-timer>
                    <style>
                      #shopify-block-{{ block.id }} {
                        {%- render 'section-variables', section: block -%}
                      }
                    </style>
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'back_in_stock' -%}
              <div
                id="BackInStock-{{ section.id }}-{{ product.id }}"
                class="back-in-stock"
                {{ block.shopify_attributes }}
              >
                {%- liquid
                  assign check_against_inventory = true
                  if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                    assign check_against_inventory = false
                  endif
                  if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                    assign quantity_rule_soldout = true
                  endif

                  if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                    render 'back-in-stock', product: product, product_id: product.id, section_id: section.id, heading: block.settings.heading, description: block.settings.description, compact: true
                  endif
                -%}
              </div>

            {%- when 'product_bundle' -%}
              {%- liquid
                assign products = block.settings.products

                if block.settings.metafield != blank
                  assign metafield_parts = block.settings.metafield | split: '.'
                  assign metafield_namespace = metafield_parts | first
                  assign metafield_key = metafield_parts | last

                  assign metafield = product.metafields[metafield_namespace][metafield_key]
                  if metafield.value != blank and metafield.list?
                    assign products = metafield.value
                  endif

                  assign metafield = product.selected_or_first_available_variant.metafields[metafield_namespace][metafield_key]
                  if metafield.value != blank and metafield.list?
                    assign products = metafield.value
                  endif
                endif
              -%}
              <div id="ProductBundle-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                {%- if products.count > 0 -%}
                  <details
                    class="product__accordion details with-background"
                    is="product-bundle-details"
                    {% if product.selected_or_first_available_variant.available and block.settings.opened %}
                      open
                    {% endif %}
                    form="{{ product_form_id }}"
                  >
                    <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                      <div class="flex items-center gap-2d5">
                        {%- if block.settings.icon_image != blank -%}
                          {%- liquid
                            if block.settings.iwidth == 'fit'
                              assign icon_width = block.settings.icon_image.width
                            else
                              assign icon_width = block.settings.icon_width
                            endif
                          -%}
                          <figure class="media media--transparent relative inline-block">
                            {%- capture sizes -%}{{ icon_width }}px{%- endcapture -%}
                            {%- capture widths -%}{{ icon_width }}, {{ icon_width | times: 2 | at_most: block.settings.icon_image.width }}{%- endcapture -%}
                            {%- assign image_alt = block.settings.icon_image.alt
                              | default: block.settings.accessibility_info
                              | escape
                            -%}
                            {%- assign image_alt = image_alt | default: block.settings.heading | escape -%}
                            {{-
                              block.settings.icon_image
                              | image_url: width: block.settings.icon_image.width
                              | image_tag:
                                loading: 'lazy',
                                sizes: sizes,
                                widths: widths,
                                alt: image_alt,
                                class: 'image-fit'
                            -}}
                          </figure>
                        {%- elsif block.settings.icon != 'none' -%}
                          {%- liquid
                            if block.settings.iwidth == 'fit'
                              render 'icon-guarantee', icon: block.settings.icon, size: 'lg', class: 'inline-block stroke-1'
                            else
                              render 'icon-guarantee', icon: block.settings.icon, size: 'custom', class: 'inline-block stroke-1', width: block.settings.icon_width
                            endif
                          -%}
                        {%- endif -%}
                        <span class="text-sm-base font-medium leading-none">{{ block.settings.heading | escape }}</span>
                      </div>
                      {%- render 'icon', icon: 'plus-2', size: 'xs', class: 'shrink-0' -%}
                    </summary>
                    <div class="details__content grid gap-2">
                      {%- for product in products -%}
                        {%- liquid
                          assign variant = product.first_available_variant | default: product
                          assign show_variant_title = true

                          if variant.product.has_only_default_variant
                            assign show_variant_title = false
                          endif

                          if product.first_available_variant == null
                            assign show_variant_title = false
                          endif
                        -%}
                        {%- if variant.product -%}
                          {%- assign variant_image = variant.image | default: variant.product.featured_image -%}
                          <label
                            class="product-bundle__info flex items-center gap-4 md:gap-6"
                            for="Recommendations-{{ section.id }}-{{ variant.id }}"
                          >
                            <input
                              name="bundles"
                              value="{{ variant.id }}"
                              data-price="{{ variant.price }}"
                              class="checkbox"
                              id="Recommendations-{{ section.id }}-{{ variant.id }}"
                              type="checkbox"
                              {% unless variant.available %}
                                disabled
                              {% endunless %}
                            >
                            {%- if variant_image -%}
                              <picture class="horizontal-product__media media media--{{ settings.product_image_ratio }}{% unless settings.product_image_fill %} media--contain{% endunless %} relative overflow-hidden shrink-0 pointer-events-none">
                                {{-
                                  variant_image
                                  | image_url: width: variant_image.width
                                  | image_tag: loading: 'lazy', widths: '180,360,540', is: 'lazy-image'
                                -}}
                              </picture>
                            {%- endif -%}
                            <div class="horizontal-product__details grow flex flex-col justify-start gap-1d5">
                              <div class="flex flex-col gap-1">
                                <p class="horizontal-product__title font-medium text-base leading-tight">
                                  {%- liquid
                                    if block.settings.clickable
                                      echo variant.product.title | link_to: variant.url, class: 'reversed-link'
                                    else
                                      echo variant.product.title | escape
                                    endif
                                  -%}
                                </p>
                                {%- if show_variant_title -%}
                                  <span class="text-xs text-opacity leading-tight">{{ variant.title }}</span>
                                {%- endif -%}
                              </div>
                            </div>
                            <div class="horizontal-product__quantity shrink-0">
                              {%- if variant.available -%}
                                {%- render 'product-price',
                                  product: variant.product,
                                  variant: variant,
                                  use_variant: true,
                                  class: 'flex flex-wrap items-baseline gap-2 lg:flex-col xl:items-end lg:gap-1d5'
                                -%}
                              {%- else -%}
                                <span class="text-sm-base text-opacity">{{ 'products.product.sold_out' | t }}</span>
                              {%- endif -%}
                            </div>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
                {%- endif -%}
              </div>

            {%- when 'icon_list' -%}
              {{- icon_list_render -}}

            {%- when 'line_item_property' -%}
              {%- assign custom_name = block.settings.title | escape -%}
              <div class="field" {{ block.shopify_attributes }}>
                {%- if block.settings.type == 'checkbox' -%}
                  <label
                    for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                    class="flex items-center gap-3"
                  >
                    <input
                      type="hidden"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.unchecked_value | escape }}"
                    >
                    <input
                      type="checkbox"
                      id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.checked_value | escape }}"
                      {%- if block.settings.required %}
                        required
                      {% endif -%}
                    >
                    {{- block.settings.title | escape -}}
                  </label>

                {%- elsif block.settings.type == 'radio' -%}
                  <div class="grid gap-4">
                    <p>{{ block.settings.title | escape }}</p>
                    {%- assign options = block.settings.radio_options | split: ',' -%}
                    {%- if options.size > 0 -%}
                      <ul class="grid gap-2 leading-none" role="list">
                        {%- for option in options -%}
                          {%- assign option_2 = option | strip | escape -%}
                          <li>
                            <label
                              for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}"
                              class="inline-flex items-center gap-3"
                            >
                              <input
                                type="radio"
                                id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}"
                                name="properties[{{ custom_name }}]"
                                form="{{ product_form_id }}"
                                value="{{ option_2 }}"
                                {%- if block.settings.required %}
                                  required
                                {% endif -%}
                              >
                              {{- option_2 -}}
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                {%- else -%}
                  {%- case block.settings.type -%}
                    {%- when 'text' -%}
                      <input
                        class="input is-floating"
                        type="text"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder="{{ block.settings.title | escape }}"
                        {%- if block.settings.required %}
                          required
                        {% endif -%}
                      >
                      <label
                        class="label is-floating"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>

                    {%- when 'textarea' -%}
                      <textarea
                        class="textarea is-floating"
                        rows="5"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder=" "
                        {%- if block.settings.required %}
                          required
                        {% endif -%}
                      ></textarea>
                      <label
                        class="label is-floating"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>

                    {%- when 'select' -%}
                      {%- assign options = block.settings.select_options | split: ',' -%}
                      {%- if options.size > 0 -%}
                        <select
                          class="select is-floating"
                          id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                          name="properties[{{ custom_name }}]"
                          form="{{ product_form_id }}"
                          {%- if block.settings.required %}
                            required
                          {% else %}
                            is="custom-select"
                          {% endif -%}
                        >
                          <option value="" disabled selected></option>
                          {%- for option in options -%}
                            {%- assign option_2 = option | strip | escape -%}
                            <option value="{{ option_2 }}">{{ option_2 }}</option>
                          {%- endfor -%}
                        </select>
                        {%- render 'icon', icon: 'chevron-up', size: 'sm', class: 'absolute pointer-events-none' -%}
                      {%- endif -%}
                      <label
                        class="label{% if options.size > 0 %} is-floating{% endif %}"
                        for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      >
                        {{- block.settings.title | escape -}}
                      </label>
                  {%- endcase -%}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </product-info>
    </div>

    {%- assign sticky_buy_button = section.blocks | where: 'type', 'sticky_buy_button' | first -%}
    {%- assign sticky_buy_button_v2 = section.blocks | where: 'type', 'sticky_buy_button_v2' | first -%}
    {%- if product.available and sticky_buy_button and sticky_buy_button_v2 == blank -%}
      <product-sticky-form
        class="product-sticky-form w-full fixed z-20 bottom-0 right-0 pointer-events-none"
        id="ProductStickyForm-{{ section.id }}-{{ product.id }}"
        form="{{ product_form_id }}"
      >
        <div class="product-sticky-form__card grid gap-4 opacity-0 invisible pointer-events-auto">
          {%- assign featured_media = product.selected_or_first_available_variant.featured_media
            | default: product.featured_media
          -%}
          <div class="product-sticky-form__variant{% if featured_media == blank %} no-image{% endif %} grid items-center gap-4">
            {%- if featured_media != blank -%}
              <div
                class="hidden md:block media media--adapt relative overflow-hidden"
                data-widths="80,160"
                data-sticky-product-media
              >
                {{-
                  featured_media
                  | image_url: width: featured_media.width
                  | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', is: 'lazy-image'
                -}}
              </div>
            {%- endif -%}

            <div class="grid gap-2">
              <div class="grid gap-1">
                <p class="text-base font-medium leading-tight">{{ product.title }}</p>
                {%- unless product.has_only_default_variant -%}
                  <div class="text-xs text-opacity leading-tight" data-sticky-product-options>
                    {{- product.selected_or_first_available_variant.title -}}
                  </div>
                {%- endunless -%}
              </div>
              <div id="StickyPrice-{{ section.id }}-{{ product.id }}">
                {%- if product.quantity_price_breaks_configured? != true -%}
                  {%- render 'product-price',
                    product: product,
                    use_variant: true,
                    class: 'flex flex-wrap items-center gap-2 lg:gap-1d5'
                  -%}
                {%- else -%}
                  {%- liquid
                    assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id
                    assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                    assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                    if cart_qty > 0
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                    endif
                    assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                  -%}
                  <price-per-item
                    id="PricePerItem-{{ section.id }}-{{ product.id }}-2nd"
                    class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {%- if variant_price_compare -%}
                      <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                      <span class="price__sale inline-flex items-center h-auto relative">
                        {%- liquid
                          if settings.currency_code_enabled
                            echo variant_price_compare | money_with_currency
                          else
                            echo variant_price_compare | money
                          endif
                        -%}
                      </span>
                      <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                    {%- endif -%}

                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                      {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span class="price-per-item--current price__regular whitespace-nowrap">
                          {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                        </span>
                      {%- else -%}
                        {%- for price_break in volume_pricing_array -%}
                          {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign price_break_price = price_break.price | money_with_currency
                              else
                                assign price_break_price = price_break.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                            </span>
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    {%- else -%}
                      <span class="price-per-item--current price__regular whitespace-nowrap">
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                      </span>
                    {%- endif -%}
                  </price-per-item>
                {%- endif -%}
              </div>
            </div>

            {%- liquid
              assign check_against_inventory = true
              if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif
              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif
            -%}
            <button
              type="submit"
              name="add"
              form="{{ product_form_id }}"
              class="button button--primary"
              is="hover-button"
              {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %}
                disabled
              {% endif -%}
              {%- if product.template_suffix == 'pre-order' %}
                data-pre-order
              {% endif -%}
            >
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'cart', size: 'sm', class: 'md:hidden' -%}
                <span class="hidden md:block" data-sold-out="{{ 'products.product.sold_out' | t | escape }}">
                  {%- liquid
                    if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                      echo 'products.product.sold_out' | t
                    elsif product.template_suffix != 'pre-order'
                      echo 'products.product.add_to_cart' | t
                    else
                      echo 'products.product.pre_order' | t
                    endif
                  -%}
                </span>
              </span>
            </button>
          </div>
          <div
            class="product-form__error-message alert alert--error text-sm font-medium leading-tight"
            role="alert"
            hidden
          ></div>
        </div>
      </product-sticky-form>
    {%- endif -%}

    {%- if product.available and sticky_buy_button_v2 -%}
      {%- liquid
        assign check_against_inventory_v2 = true
        if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
          assign check_against_inventory_v2 = false
        endif
        if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory_v2
          assign quantity_rule_soldout_v2 = true
        endif
      -%}

      <product-sticky-form
        class="product-sticky-form-v2"
        id="ProductStickyFormV2-{{ section.id }}-{{ product.id }}"
        form="{{ product_form_id }}"
      >
        <div class="sticky-bar-custom-v2">
          <div class="sticky-bar-custom-v2__inner">
            <div class="sticky-bar-custom-v2__info">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>
                {{-
                  sticky_buy_button_v2.settings.delivery_text
                  | default: 'In Stock—Estimated delivery in 1-5 business days.'
                -}}
              </span>
            </div>

            <div class="sticky-bar-custom-v2__actions">
              <div class="sticky-bar-custom-v2__price" id="StickyPriceV2-{{ section.id }}-{{ product.id }}">
                {%- render 'product-price',
                  product: product,
                  use_variant: true,
                  class: 'flex flex-wrap items-center gap-2'
                -%}
              </div>

              <button
                type="submit"
                name="add"
                form="{{ product_form_id }}"
                class="sticky-bar-custom-v2__btn sticky-bar-custom-v2__btn--atc"
                {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout_v2 %}
                  disabled
                {% endif -%}
                {%- if product.template_suffix == 'pre-order' %}
                  data-pre-order
                {% endif -%}
              >
                {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout_v2 -%}
                  {{ 'products.product.sold_out' | t }}
                {%- elsif product.template_suffix != 'pre-order' -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.pre_order' | t }}
                {%- endif -%}
              </button>

              <button
                type="button"
                class="sticky-bar-custom-v2__btn sticky-bar-custom-v2__btn--buy js-sticky-buy-now-v2-{{ section.id }}-{{ product.id }}"
                {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout_v2 %}
                  disabled
                {% endif -%}
              >
                {{ sticky_buy_button_v2.settings.buy_now_text | default: 'Buy Now' }}
              </button>
            </div>
          </div>
        </div>

        <div
          class="product-form__error-message alert alert--error text-sm font-medium leading-tight"
          role="alert"
          hidden
        ></div>
      </product-sticky-form>

      <style>
        .product-sticky-form-v2 {
          position: fixed !important;
          left: 0 !important;
          bottom: 0 !important;
          width: 100% !important;
          z-index: 10 !important;
          pointer-events: none;
          display: block !important;
        }
        .sticky-bar-custom-v2 {
          pointer-events: auto;
          background: #fff;
          box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.08);
        }
        .sticky-bar-custom-v2__inner {
          display: flex;
          justify-content: space-between;
          align-items: center;
          max-width: 1600px;
          margin: 0 auto;
          padding: 15px 40px;
          gap: 12px;
        }
        .sticky-bar-custom-v2__info {
          display: flex;
          align-items: center;
          gap: 10px;
          font-size: 14px;
          color: #333;
          line-height: 1.3;
        }
        .sticky-bar-custom-v2__actions {
          display: flex;
          align-items: center;
          gap: 15px;
        }
        .sticky-bar-custom-v2__price {
          font-size: 24px;
          font-weight: 700;
          color: #111;
          margin-right: 10px;
          white-space: nowrap;
        }
        .sticky-bar-custom-v2__price .price {
          display: flex;
          align-items: center;
          gap: 8px;
          flex-wrap: nowrap;
        }
        .sticky-bar-custom-v2__price .price__regular,
        .sticky-bar-custom-v2__price .price__sale,
        .sticky-bar-custom-v2__price .price dd {
          font-size: 24px;
          font-weight: 700;
        }

        .sticky-bar-custom-v2__btn {
          padding: 12px 30px;
          font-size: 16px;
          font-weight: 600;
          border-radius: 4px;
          cursor: pointer;
          border: none;
          transition: opacity 0.2s;
          text-align: center;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 140px;
          line-height: 1.2;
        }
        .sticky-bar-custom-v2__btn:disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }
        .sticky-bar-custom-v2__btn:not(:disabled):hover {
          opacity: 0.85;
        }
        .sticky-bar-custom-v2__btn--atc {
          background: transparent;
          border: 1px solid #9887b8;
          color: #9887b8;
        }
        .sticky-bar-custom-v2__btn--buy {
          background: #9887b8;
          color: #fff;
        }

        @media (max-width: 768px) {
          .sticky-bar-custom-v2__inner {
            flex-direction: column;
            padding: 10px 15px;
            gap: 8px;
            align-items: flex-start;
          }
          .sticky-bar-custom-v2__info svg {
            width: 14px;
            height: 14px;
          }
          .sticky-bar-custom-v2__info {
            font-size: 12px;
          }
          .sticky-bar-custom-v2__price {
            width: 100%;
            margin-right: 0;
            font-size: 20px;
          }
          .sticky-bar-custom-v2__price .price__regular,
          .sticky-bar-custom-v2__price .price__sale,
          .sticky-bar-custom-v2__price .price dd {
            font-size: 20px;
          }
          .sticky-bar-custom-v2__actions {
            width: 100%;
            flex-wrap: wrap;
          }
          .sticky-bar-custom-v2__btn {
            flex: 1;
            min-width: 0;
            padding: 10px 15px;
            font-size: 14px;
          }
        }
      </style>

      <script>
        (function () {
          var buyBtn = document.querySelector('.js-sticky-buy-now-v2-{{ section.id }}-{{ product.id }}');
          if (!buyBtn) return;

          var productFormId = '{{ product_form_id }}';
          var currentVariantId = '{{ product.selected_or_first_available_variant.id }}';
          var variantMap = {
            {% for variant in product.variants %}
              "{{ variant.id }}": true{% unless forloop.last %},{% endunless %}
            {% endfor %}
          };

          function getVariantId() {
            var form = document.getElementById(productFormId);
            if (form) {
              var idInput = form.querySelector('input[name="id"], select[name="id"]');
              if (idInput && variantMap[idInput.value]) return idInput.value;
            }
            var urlVid = new URLSearchParams(window.location.search).get('variant');
            if (urlVid && variantMap[urlVid]) return urlVid;
            return currentVariantId;
          }

          function getQuantity() {
            var form = document.getElementById(productFormId);
            if (form) {
              var q = form.querySelector('input[name="quantity"]');
              if (q) return parseInt(q.value, 10) || 1;
            }

            var inputs = document.querySelectorAll('input[name="quantity"]');
            for (var i = 0; i < inputs.length; i++) {
              if (!inputs[i].closest('[id*="drawer"]') && !inputs[i].closest('.cart-drawer') && !inputs[i].closest('.mini-cart')) {
                return parseInt(inputs[i].value, 10) || 1;
              }
            }
            return 1;
          }

          buyBtn.addEventListener('click', function (e) {
            e.preventDefault();
            var vid = getVariantId();
            var qty = getQuantity();
            if (!vid) return;

            buyBtn.disabled = true;
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ id: parseInt(vid, 10), quantity: qty })
            })
              .then(function (res) {
                if (!res.ok) throw new Error(res.status);
                window.location.href = '/checkout';
              })
              .catch(function () {
                buyBtn.disabled = false;
              });
          });
        })();
      </script>
    {%- endif -%}
  </div>

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {%- endif -%}

  <script type="application/ld+json">
    {{- product | structured_data -}}
  </script>
</div>

