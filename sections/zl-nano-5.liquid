{%- style -%}
  .zl-spe-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .zl-spe-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .zl-spe-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .zl-spe-title {
    font-size: {{ section.settings.title_size_pc }}px;
    color: {{ section.settings.title_color }};
    font-weight: {{ section.settings.title_weight }};
    margin: 0 0 12px;
  }

  .zl-spe-link {
    font-size: {{ section.settings.link_size_pc }}px;
    color: {{ section.settings.link_color }};
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .zl-spe-link:hover {
    opacity: 0.9;
  }

  .zl-spe-table-container {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .zl-spe-table-container::-webkit-scrollbar {
    display: none;
  }

  .zl-spe-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks | size | at_most: 5 }}, minmax(200px, 1fr));
    gap: 20px;
    width: 100%;
  }

  .zl-spe-column {
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 40px;
  }

  .zl-spe-product-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 250px;
  }

  .zl-spe-img-wrap {
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    text-decoration: none;
  }

  .zl-spe-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .zl-spe-color-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
    min-height: 16px;
  }

  .zl-spe-badge {
    color: {{ section.settings.badge_color }};
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
    height: 14px;
  }

  .zl-spe-product-title {
    font-size: {{ section.settings.product_title_size_pc }}px;
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.product_title_weight }};
    margin: 0 0 12px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
    max-width: 350px;
  }

  .zl-spe-price {
    font-size: {{ section.settings.price_size_pc }}px;
    font-weight: bold;
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
  }

  .zl-spe-btn {
    display: inline-block;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_color }};
    padding: 8px 24px;
 
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: opacity 0.3s;
    width: 70%;
  }

  .zl-spe-btn:hover {
    opacity: 0.8;
  }

  .zl-spe-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    min-height:46px;
  }

  .zl-spe-row-label {
    font-size: {{ section.settings.spec_label_size_pc }}px;
    color: {{ section.settings.spec_label_color }};
    margin-bottom: 6px;
  }

  .zl-spe-row-value {
    font-size: {{ section.settings.spec_value_size_pc }}px;
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.spec_value_weight }};
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .zl-spe-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    .zl-spe-title {
      font-size: {{ section.settings.title_size_mb }}px;
    }

    .zl-spe-link {
      font-size: {{ section.settings.link_size_mb }}px;
    }

    .zl-spe-grid {
      grid-template-columns: repeat({{ section.blocks | size | at_least: 2 }}, 220px);
      gap: 25px;
      padding-bottom: 20px;
    }

    .zl-spe-product-title {
      font-size: {{ section.settings.product_title_size_mb }}px;
    }

    .zl-spe-price {
      font-size: {{ section.settings.price_size_mb }}px;
    }

    .zl-spe-row-label {
      font-size: {{ section.settings.spec_label_size_mb }}px;
    }

    .zl-spe-row-value {
      font-size: {{ section.settings.spec_value_size_mb }}px;
    }

    .zl-spe-img-wrap {
      height: 160px;
    }

    .zl-spe-column {
      gap: 20px;
    }
  }
{%- endstyle -%}

<section class="zl-spe-section-{{ section.id }}">
  <div class="zl-spe-container">
    <div class="zl-spe-header">
      {%- if section.settings.title != blank -%}
        <h2 class="zl-spe-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.link_text != blank -%}
        <a href="{{ section.settings.link_url }}" class="zl-spe-link">{{ section.settings.link_text }} ></a>
      {%- endif -%}
    </div>

    <div class="zl-spe-table-container">
      <div class="zl-spe-grid">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}

          <div class="zl-spe-column" {{ block.shopify_attributes }}>
            <div class="zl-spe-product-header">
              <a href="{{ product.url | default: '#' }}" class="zl-spe-img-wrap">
                {%- if block.settings.custom_image != blank -%}
                  <img src="{{ block.settings.custom_image | image_url: width: 300 }}" alt="{{ block.settings.custom_title | escape }}" class="zl-spe-img" loading="lazy">
                {%- elsif product != blank and product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" class="zl-spe-img" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'zl-spe-img' }}
                {%- endif -%}
              </a>

              <div class="zl-spe-color-dots">
                {%- if block.settings.show_color_swatches and product != blank -%}
                  {%- liquid
                    assign swatch_trigger_list = 'products.general.color_swatch_trigger' | t | downcase | split: ','
                    assign color_count = 0
                  -%}
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign is_color = false
                      assign option_name = option.name | downcase
                      for trigger in swatch_trigger_list
                        assign swatch_trigger = trigger | strip
                        if option_name contains swatch_trigger
                          assign is_color = true
                        elsif swatch_trigger == 'color' and option_name contains 'colour'
                          assign is_color = true
                        endif

                        if is_color == true
                          break
                        endif
                      endfor
                    -%}
                    {%- if is_color -%}
                      {%- liquid
                        assign option_index = forloop.index0
                        assign values = ''
                        assign max_color_count = settings.product_max_color_swatches | default: 6
                      -%}
                      <ul class="swatches swatches--{{ settings.rounded_swatch }}{% if settings.product_color_swatch_type == 'variant' %} swatches--variant{% endif %} swatches--{{ product.id }} inline-flex items-start gap-2 m-0 p-0 list-none">
                        {%- for variant in product.variants -%}
                          {%- assign value = variant.options[option_index] %}
                          {%- unless values contains value -%}
                            {%- liquid
                              assign values = values | join: ',' | append: ',' | append: value | split: ','
                              assign color_count = color_count | plus: 1
                              assign color_title = product.title | append: ' - ' | append: value
                              assign color_url = variant.url | within: collection
                              if settings.product_disable_collection_portion
                                assign color_url = variant.url
                              endif

                              assign swatch = blank
                              if value.swatch != blank
                                assign swatch = value.swatch
                              endif

                              if settings.product_color_swatch_type == 'variant' and variant.image
                                assign swatch = variant
                              endif
                            -%}
                            {%- if color_count <= max_color_count -%}
                              <li>
                                {%- render 'swatch', href: color_url, title: color_title, value: value, value_label: value, swatch: swatch -%}
                              </li>
                            {%- endif -%}
                          {%- endunless -%}
                        {%- endfor -%}
                      </ul>
                      {%- if color_count > max_color_count -%}
                        <a href="{{ product.url }}" class="reversed-link font-medium text-xs text-opacity leading-none tracking-widest" is="hover-link"{% if show_quick_view %} aria-controls="{{ quick_view_id }}" aria-expanded="false"{% endif %}>+{{ color_count | minus: max_color_count }}</a>
                      {%- endif -%}
                      {%- if color_count < 1 -%}
                        <style>
                          .swatches--{{ product.id }} { display: none; }
                        </style>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <div class="zl-spe-badge">{{ block.settings.badge }}</div>

              <h4 class="zl-spe-product-title">
                {{ block.settings.custom_title | default: product.title | default: 'Product Title' }}
              </h4>

              <div class="zl-spe-price">
                {%- if block.settings.custom_price != blank -%}
                  {{ block.settings.custom_price }}
                {%- elsif product != blank -%}
                  {{ product.price | money }}
                {%- else -%}
                  $99.00
                {%- endif -%}
              </div>

              <a href="{{ product.url | default: '#' }}" class="zl-spe-btn">{{ section.settings.btn_text }}</a>
            </div>

            {%- for i in (1..10) -%}
              {%- capture label_key -%}spec_{{ i }}_label{%- endcapture -%}
              {%- capture val_key -%}spec_{{ i }}{%- endcapture -%}
              {%- assign spec_label = section.settings[label_key] -%}
              {%- assign spec_val = block.settings[val_key] -%}

              {%- if spec_label != blank or spec_val != blank -%}
                <div class="zl-spe-row">
                  {%- if spec_label != blank -%}
                    <div class="zl-spe-row-label">{{ spec_label }}</div>
                  {%- endif -%}
                  <div class="zl-spe-row-value">
                    {%- if spec_val != blank -%}
                      {{ spec_val | newline_to_br }}
                    {%- else -%}
                      /
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
