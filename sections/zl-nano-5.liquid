      "label": "Link Color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "link_size_pc",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Link Size (PC)",
      "default": 14
    },
    {
      "type": "range",
      "id": "link_size_mb",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Link Size (Mobile)",
