    },
    {
      "type": "range",
      "id": "items_pc",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Items Per Row (PC)",
      "default": 6
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (PC)",
      "default": 20
    },
    {
      "type": "select",
      "id": "mobile_layout",
