    {
      "type": "range",
      "id": "price_size_mb",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Price Size (Mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "price_weight",
      "label": "Price Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "Compare Price Color",
      "default": "#888888"
    },
    {
      "type": "range",
      "id": "compare_size_pc",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Compare Price Size (PC)",
      "default": 14
    },
    {
      "type": "range",
      "id": "compare_size_mb",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Compare Price Size (Mobile)",
      "default": 12
    },
    {
      "type": "select",
      "id": "compare_weight",
      "label": "Compare Price Weight",
      "options": [
