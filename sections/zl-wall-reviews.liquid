{% comment %}
  Section: ZL - Marquee Reviews (Infinite Scroll)
  Description: Two rows of reviews scrolling in opposite directions.
  Class Naming: zl-mq-*
{% endcomment %}

{%- liquid
  assign section_id = 'zl-mq-' | append: section.id
  
  # Split blocks into two groups
  assign total_blocks = section.blocks.size
  assign half_index = total_blocks | divided_by: 2 | ceil
-%}

<section id="{{ section_id }}" class="zl-mq-section">
  <div class="zl-mq-container">
    
    <div class="zl-mq-header">
      {% if section.settings.heading != blank %}
        <h2 class="zl-mq-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <div class="zl-mq-subtext">{{ section.settings.subtext }}</div>
      {% endif %}
    </div>

    <div class="zl-mq-wrapper">
      
      <div class="zl-mq-row zl-mq-scroll-left">
        {% for i in (1..4) %}
          <div class="zl-mq-track">
            {% for block in section.blocks limit: half_index %}
              
              <div class="zl-mq-card" {{ block.shopify_attributes }}>
                <div class="zl-mq-top-row">
                  <div class="zl-mq-profile">
                    {% if block.settings.avatar != blank %}
                      {{ block.settings.avatar | image_url: width: 80 | image_tag: class: 'zl-mq-avatar', loading: 'lazy' }}
                    {% else %}
                      <div class="zl-mq-avatar" style="background:#ddd;"></div>
                    {% endif %}
                    <span class="zl-mq-author">{{ block.settings.author }}</span>
                  </div>
                  <div class="zl-mq-stars">
                    {% for s in (1..block.settings.stars) %}
                      <svg class="zl-mq-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {% endfor %}
                  </div>
                </div>
                <div class="zl-mq-body">
                  {% if block.settings.review_title != blank %}
                    <strong class="zl-mq-title">{{ block.settings.review_title }}</strong>
                  {% endif %}
                  {{ block.settings.text }}
                </div>
                <div class="zl-mq-verified">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                  Verified Buyer
                </div>
              </div>
              {% endfor %}
          </div>
        {% endfor %}
      </div>

      <div class="zl-mq-row zl-mq-scroll-right">
        {% for i in (1..4) %}
          <div class="zl-mq-track">
            {% for block in section.blocks offset: half_index %}
              
              <div class="zl-mq-card" {{ block.shopify_attributes }}>
                <div class="zl-mq-top-row">
                  <div class="zl-mq-profile">
                    {% if block.settings.avatar != blank %}
                      {{ block.settings.avatar | image_url: width: 80 | image_tag: class: 'zl-mq-avatar', loading: 'lazy' }}
                    {% else %}
                      <div class="zl-mq-avatar" style="background:#ddd;"></div>
                    {% endif %}
                    <span class="zl-mq-author">{{ block.settings.author }}</span>
                  </div>
                  <div class="zl-mq-stars">
                    {% for s in (1..block.settings.stars) %}
                      <svg class="zl-mq-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    {% endfor %}
                  </div>
                </div>
                <div class="zl-mq-body">
                  {% if block.settings.review_title != blank %}
                    <strong class="zl-mq-title">{{ block.settings.review_title }}</strong>
                  {% endif %}
                  {{ block.settings.text }}
                </div>
                <div class="zl-mq-verified">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                  Verified Buyer
                </div>
              </div>
              {% endfor %}
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
  #{{ section_id }} * { box-sizing: border-box; }

  #{{ section_id }}.zl-mq-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .zl-mq-container {
    width: 100%; 
    margin: 0 auto;
  }

  /* Header */
  .zl-mq-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }
  .zl-mq-heading {
    font-size: 36px;
    font-weight: 800;
    margin: 0 0 10px 0;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
  }
  .zl-mq-subtext {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
  }

  /* Marquee Structure */
  .zl-mq-wrapper {
    display: flex;
    flex-direction: column;
    gap: 24px; /* Gap between rows */
  }

  .zl-mq-row {
    display: flex;
    overflow: hidden;
    width: 100%;
    position: relative;
    /* Mask effect on sides to make it fade out */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  
  /* Stop animation on hover */
  .zl-mq-row:hover .zl-mq-track {
    animation-play-state: paused;
  }

  .zl-mq-track {
    display: flex;
    flex-shrink: 0;
    gap: 24px; /* Gap between cards */
    padding-right: 24px;
    
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-duration: {{ section.settings.speed }}s; 
  }

  /* Animations */
  .zl-mq-scroll-left .zl-mq-track {
    animation-name: zl-scroll-left;
  }
  .zl-mq-scroll-right .zl-mq-track {
    animation-name: zl-scroll-right;
  }

  @keyframes zl-scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @keyframes zl-scroll-right {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(0); }
  }

  /* Card Styles */
  .zl-mq-card {
    flex: 0 0 320px; /* Fixed card width */
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.03);
    height: 100%;
    user-select: none;
  }

  .zl-mq-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  
  .zl-mq-profile {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .zl-mq-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: #e0e0e0;
  }
  .zl-mq-author {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }

  .zl-mq-stars {
    color: {{ section.settings.star_color }};
    display: flex;
    gap: 1px;
  }
  .zl-mq-star { width: 16px; height: 16px; }

  .zl-mq-body {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.9;
    flex-grow: 1;
  }
  
  .zl-mq-title {
    display: block;
    margin-bottom: 6px;
    color: {{ section.settings.heading_color }};
  }

  .zl-mq-verified {
    margin-top: 16px;
    font-size: 12px;
    color: #27ae60;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .zl-mq-card {
      flex: 0 0 280px;
      padding: 18px;
    }
    .zl-mq-heading { font-size: 28px; }
  }
</style>

{% schema %}
{
  "name": "ZL - Marquee Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by thousands"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "See what our customers are saying"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 60,
      "label": "Scroll Duration (Seconds)",
      "info": "Larger number = Slower speed"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading/Name Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#FFB800"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "User Avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah J."
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Stars"
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review Title (Optional)",
          "default": "Amazing quality!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "I was skeptical at first, but this product really changed my daily routine. Highly recommended!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZL - Marquee Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}