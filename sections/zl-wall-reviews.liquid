{% comment %}
  Section: ZL - Wall of Love (Masonry Reviews)
  Description: A masonry grid layout for testimonials similar to Momcozy.
  Class Naming: zl-wall-*
{% endcomment %}

{%- liquid
  assign section_id = 'zl-wall-' | append: section.id
-%}

<section id="{{ section_id }}" class="zl-wall-section">
  <div class="zl-wall-container">
    
    <div class="zl-wall-header">
      {% if section.settings.heading != blank %}
        <h2 class="zl-wall-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <div class="zl-wall-subtext">{{ section.settings.subtext }}</div>
      {% endif %}
    </div>

    <div class="zl-wall-wrapper">
      <div class="zl-wall-grid">
        
        {% for block in section.blocks %}
          <div class="zl-wall-card zl-card-layout-{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
            
            {% if block.settings.image != blank %}
              <div class="zl-wall-img-box">
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'zl-wall-img' }}
              </div>
            {% endif %}

            <div class="zl-wall-content">
              <div class="zl-wall-top-row">
                {% if block.settings.review_title != blank %}
                  <h3 class="zl-wall-card-title">{{ block.settings.review_title }}</h3>
                {% endif %}
                
                <div class="zl-wall-stars">
                  {% for i in (1..block.settings.stars) %}
                    <svg class="zl-wall-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  {% endfor %}
                </div>
              </div>

              <div class="zl-wall-body">
                {{ block.settings.text }}
              </div>

              <div class="zl-wall-author-row">
                <span class="zl-wall-line"></span>
                <span class="zl-wall-author">{{ block.settings.author }}</span>
              </div>
            </div>

          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
  #{{ section_id }} * { box-sizing: border-box; }

  #{{ section_id }}.zl-wall-section {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .zl-wall-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  .zl-wall-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .zl-wall-heading {
    font-size: 36px;
    font-weight: 800;
    margin: 0 0 10px 0;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
  }
  .zl-wall-subtext {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
  }

  /* Masonry Grid Logic (CSS Columns) */
  .zl-wall-grid {
    column-count: 3; /* 3 Columns on Desktop */
    column-gap: 20px;
  }

  /* Card Styles */
  .zl-wall-card {
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    margin-bottom: 20px; /* Space between vertical items */
    break-inside: avoid; /* Prevent card from splitting across columns */
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: transform 0.3s ease;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .zl-wall-card:hover {
    transform: translateY(-3px);
  }

  /* Layout: Image Top (Default Stack) */
  .zl-card-layout-top {
    display: flex;
    flex-direction: column;
  }
  .zl-card-layout-top .zl-wall-img-box {
    width: 100%;
    height: 200px;
  }

  /* Layout: Image Left (Side by Side) */
  .zl-card-layout-left {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }
  .zl-card-layout-left .zl-wall-img-box {
    width: 40%;
    min-height: 100%;
    flex-shrink: 0;
  }
  .zl-card-layout-left .zl-wall-content {
    width: 60%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Image Common */
  .zl-wall-img-box {
    overflow: hidden;
    background: #f4f4f4;
  }
  .zl-wall-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Content Area */
  .zl-wall-content {
    padding: 24px;
  }

  .zl-wall-top-row {
    margin-bottom: 12px;
  }
  .zl-wall-card-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 6px 0;
    color: {{ section.settings.heading_color }};
  }
  
  .zl-wall-stars {
    color: {{ section.settings.star_color }};
    display: flex;
    gap: 2px;
  }
  .zl-wall-star {
    width: 14px;
    height: 14px;
  }

  .zl-wall-body {
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
    opacity: 0.85;
  }

  /* Author Row */
  .zl-wall-author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }
  .zl-wall-line {
    width: 30px;
    height: 1px;
    background-color: {{ section.settings.text_color }};
    opacity: 0.3;
  }
  .zl-wall-author {
    font-size: 13px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  /* Responsive Mobile */
  @media (max-width: 900px) {
    .zl-wall-grid {
      column-count: 2; /* 2 cols on tablet */
    }
  }

  @media (max-width: 600px) {
    /* On mobile, turn into a horizontal scroll strip for better UX */
    .zl-wall-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 16px;
      column-count: auto;
      padding-bottom: 20px; /* Space for scrollbar */
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    
    .zl-wall-card {
      flex: 0 0 280px; /* Fixed width on mobile */
      margin-bottom: 0;
      scroll-snap-align: start;
      /* Reset layout to stack on mobile usually looks best, but let's keep variety */
    }
    
    /* Force Layout Top on mobile if it gets too squeezed? 
       Optional: uncomment below to force stack on mobile */
    /* .zl-card-layout-left { flex-direction: column; }
    .zl-card-layout-left .zl-wall-img-box { width: 100%; height: 180px; }
    .zl-card-layout-left .zl-wall-content { width: 100%; } 
    */

    .zl-wall-heading { font-size: 28px; }
  }
  
  /* Hide scrollbar */
  .zl-wall-grid::-webkit-scrollbar { display: none; }
</style>

{% schema %}
{
  "name": "ZL - Wall of Love",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chosen by over 4.5 Million* Moms Worldwide"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "*Data as of July 2025 from official platform"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFF5F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A4A4A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#A05E5E"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1400,
      "unit": "px",
      "label": "Container Width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Padding Bottom"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "default": "top",
          "options": [
            { "value": "top", "label": "Top (Stack)" },
            { "value": "left", "label": "Left (Side by Side)" }
          ],
          "info": "Use 'Left' for wider cards like the example."
        },
        {
          "type": "text",
          "id": "review_title",
          "label": "Review Title",
          "default": "Love this product."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "It works amazing sometimes you forget it's there so you pump longer without realizing it."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Emily Taylor"
        },
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star Rating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ZL - Wall of Love",
      "blocks": [
        { "type": "review", "settings": { "image_position": "left" } },
        { "type": "review", "settings": { "image_position": "top" } },
        { "type": "review", "settings": { "image_position": "left" } },
        { "type": "review", "settings": { "image_position": "top" } },
        { "type": "review", "settings": { "image_position": "top" } }
      ]
    }
  ]
}
{% endschema %}