<style>
  #shopify-section-{{ section.id }} {
    --member-purple: {{ section.settings.color_accent | default: '#9887b8' }};
    --member-purple-dark: {{ section.settings.color_accent_dark | default: '#6b5b8e' }};
    --section-padding-top: 0px;
    --section-padding-bottom: 0px;
  }

  #shopify-section-{{ section.id }} .member-hero {
    position: relative;
    min-height: {{ section.settings.min_height_mobile }}px;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .member-hero {
      min-height: {{ section.settings.min_height }}px;
    }
  }

  #shopify-section-{{ section.id }} .member-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .member-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  #shopify-section-{{ section.id }} .member-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(152, 135, 184, 0.92) 0%,
      rgba(152, 135, 184, 0.55) 38%,
      rgba(152, 135, 184, 0.15) 72%,
      rgba(152, 135, 184, 0) 100%
    );
  }

  #shopify-section-{{ section.id }} .member-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: {{ section.settings.content_padding_top_mobile }}px 0 48px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.color_text }};
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .member-hero__content {
      padding-top: {{ section.settings.content_padding_top }}px;
    }
  }

  #shopify-section-{{ section.id }} .member-hero__title {
    margin: 0 0 14px;
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .member-hero__subtitle {
    margin: 0 {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %} 24px;
    max-width: 560px;
    font-size: clamp(14px, 1.8vw, 17px);
    line-height: 1.65;
    opacity: 0.96;
  }

  #shopify-section-{{ section.id }} .member-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .member-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 148px;
    padding: 13px 36px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  #shopify-section-{{ section.id }} .member-hero__btn--primary {
    background: var(--member-purple-dark);
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
  }

  #shopify-section-{{ section.id }} .member-hero__btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }
</style>

<div class="section section--padding{% if section.settings.rounded %} section--rounded relative{% endif %}"{% if section.settings.transparent_header %} allow-transparent-header{% endif %}>
  <div class="member-hero">
    <div class="member-hero__media">
      {%- assign hero_mobile = section.settings.image_mobile | default: section.settings.image -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.title | escape -}}
        {%- else -%}
          <div style="width:100%;height:100%;background:linear-gradient(180deg,#b8a8d4 0%,#9887b8 40%,#e8e4f2 100%);"></div>
        {%- endif -%}
      </picture>
    </div>
    <div class="member-hero__overlay"></div>
    <div class="page-width member-hero__content">
      {%- if section.settings.title != blank -%}
        <h1 class="member-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="member-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="member-hero__actions">
          <a href="{{ section.settings.button_link | default: routes.account_register_url }}" class="member-hero__btn member-hero__btn--primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Member rewards hero",
  "tag": "section",
  "class": "member-section member-section--hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 320,
      "max": 720,
      "step": 10,
      "unit": "px",
      "label": "Minimum height desktop",
      "default": 520
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 280,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Minimum height mobile",
      "default": 420
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "min": 48,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Content offset from top (desktop)",
      "default": 88
    },
    {
      "type": "range",
      "id": "content_padding_top_mobile",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Content offset from top (mobile)",
      "default": 72
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Unlock Your Rorry Club Benefits"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Free registration, extended warranty, and member-exclusive gifts."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "JOIN NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent purple",
      "default": "#9887b8"
    },
    {
      "type": "color",
      "id": "color_accent_dark",
      "label": "Button purple",
      "default": "#6b5b8e"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "Rounded section"
    }
  ],
  "presets": [
    {
      "name": "Member rewards hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  }
}
{% endschema %}
