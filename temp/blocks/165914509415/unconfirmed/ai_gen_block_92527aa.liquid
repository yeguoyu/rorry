{% doc %}
  @prompt
    Breadcrumb Navigation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-breadcrumb-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-breadcrumb-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ block.settings.spacing }}px;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
  }

  .ai-breadcrumb-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-breadcrumb-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-breadcrumb-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: {{ block.settings.hover_underline }};
  }

  .ai-breadcrumb-current-{{ ai_gen_id }} {
    color: {{ block.settings.current_color }};
  }

  .ai-breadcrumb-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    user-select: none;
  }

  .ai-breadcrumb-home-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  @media screen and (max-width: 749px) {
    .ai-breadcrumb-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-breadcrumb-nav-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<nav
  class="ai-breadcrumb-{{ ai_gen_id }}"
  aria-label="Breadcrumb"
  {{ block.shopify_attributes }}
>
  <ol class="ai-breadcrumb-nav-{{ ai_gen_id }}">
    <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
      <a
        href="/"
        class="ai-breadcrumb-link-{{ ai_gen_id }}"
        aria-label="Home"
      >
        {% if block.settings.show_home_icon %}
          <svg
            class="ai-breadcrumb-home-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        {% else %}
          {{ block.settings.home_text }}
        {% endif %}
      </a>
    </li>

    {% if template == 'collection' and collection %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ collection.title }}</span>
      </li>
    {% elsif template == 'product' and product %}
      {% if collection %}
        <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
          <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
          <a
            href="{{ collection.url }}"
            class="ai-breadcrumb-link-{{ ai_gen_id }}"
          >
            {{ collection.title }}
          </a>
        </li>
      {% endif %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ product.title }}</span>
      </li>
    {% elsif template == 'page' and page %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ page.title }}</span>
      </li>
    {% elsif template == 'article' and article %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <a
          href="{{ blog.url }}"
          class="ai-breadcrumb-link-{{ ai_gen_id }}"
        >
          {{ blog.title }}
        </a>
      </li>
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ article.title }}</span>
      </li>
    {% elsif template == 'blog' and blog %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ blog.title }}</span>
      </li>
    {% elsif template == 'search' %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ block.settings.search_text }}</span>
      </li>
    {% elsif template == 'cart' %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ block.settings.cart_text }}</span>
      </li>
    {% elsif template == 'account' or template contains 'customers' %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ block.settings.account_text }}</span>
      </li>
    {% elsif template == '404' %}
      <li class="ai-breadcrumb-item-{{ ai_gen_id }}">
        <span class="ai-breadcrumb-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        <span class="ai-breadcrumb-current-{{ ai_gen_id }}">{{ block.settings.not_found_text }}</span>
      </li>
    {% endif %}
  </ol>
</nav>

{% schema %}
{
  "name": "Breadcrumb navigation",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Home link"
    },
    {
      "type": "checkbox",
      "id": "show_home_icon",
      "label": "Show home icon",
      "default": true
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Home"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator style",
      "options": [
        {
          "value": "/",
          "label": "Slash /"
        },
        {
          "value": ">",
          "label": "Greater than >"
        },
        {
          "value": "›",
          "label": "Single angle ›"
        },
        {
          "value": "»",
          "label": "Double angle »"
        },
        {
          "value": "•",
          "label": "Bullet •"
        },
        {
          "value": "-",
          "label": "Dash -"
        }
      ],
      "default": "/"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#9887b8"
    },
    {
      "type": "select",
      "id": "hover_underline",
      "label": "Hover underline",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Current page color",
      "default": "#9887b8"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#171717"
    },
    {
      "type": "header",
      "content": "Page labels"
    },
    {
      "type": "text",
      "id": "search_text",
      "label": "Search page",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "cart_text",
      "label": "Cart page",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "account_text",
      "label": "Account page",
      "default": "Account"
    },
    {
      "type": "text",
      "id": "not_found_text",
      "label": "404 page",
      "default": "Page not found"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb navigation"
    }
  ]
}
{% endschema %}
